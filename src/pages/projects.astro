---
import ControlRoomLayout from "@/layouts/ControlRoomLayout.astro";
import ProjectsPlanner from "@/components/control-room/ProjectsPlanner.astro";
import { CLIENTS, DISCIPLINES } from "@/data/company";
import { Image } from 'astro:assets';
import menInstallCamera from "@/assets/img/gvolts/men-install-camera.png";
import instalacion2 from "@/assets/img/gvolts/instalacion2.jpg";
import electric from "@/assets/img/gvolts/electric.jpg";
import planingProject from "@/assets/img/gvolts/planing-project.png";
import instalacion from "@/assets/img/gvolts/instalacion.jpg";

const categoryFilters: Record<string, string> = {
  Seguridad: "seguridad",
  "Fire Alarm": "incendio",
  Consultoría: "consultoria",
  Electricidad: "electricidad",
};

const projects = [
  {
    image: menInstallCamera,
    title: "Instalación Comercial",
    category: "Seguridad",
    description: "Sistema completo de videovigilancia para centro comercial.",
  },
  {
    image: instalacion2,
    title: "Sistema de Incendios",
    category: "Fire Alarm",
    description: "Protección certificada para complejo residencial.",
  },
  {
    image: electric,
    title: "Red de Vigilancia",
    category: "Seguridad",
    description: "Monitoreo integral 24/7 para oficinas corporativas.",
  },
  {
    image: planingProject,
    title: "Planificación",
    category: "Consultoría",
    description: "Diseño personalizado de sistemas de seguridad.",
  },
  {
    image: instalacion,
    title: "Mantenimiento Eléctrico",
    category: "Electricidad",
    description: "Actualización de paneles y cableado para nave industrial.",
  },
  {
    // NOTE: /img/gvolts/alarm.png does not exist in public/img/gvolts — pre-existing broken image, left as raw string/skipped.
    image: "/img/gvolts/alarm.png",
    title: "Detección Temprana",
    category: "Fire Alarm",
    description: "Instalación de sensores inteligentes en edificio histórico.",
  },
].map((p, i) => ({
  ...p,
  code: `PRJ-${String(i + 1).padStart(2, "0")}`,
  filter: categoryFilters[p.category] ?? "otros",
}));

const chips = [
  { label: "Todos", filter: "todos" },
  { label: "Incendio", filter: "incendio" },
  { label: "Seguridad", filter: "seguridad" },
  { label: "Electricidad", filter: "electricidad" },
  { label: "Consultoría", filter: "consultoria" },
];
---

<ControlRoomLayout
  title="Proyectos Realizados - Portfolio de Instalaciones | GVoltsCorp"
  description="Galería de nuestros proyectos de alarmas contra incendios, sistemas de seguridad y trabajos eléctricos. Ver casos de éxito en residencial, comercial e industrial."
  accent="projects"
  breadcrumbs={[{ name: "Proyectos", path: "/projects" }]}
>
  <!-- HERO -->
  <section class="relative box-border pt-[clamp(48px,8vw,110px)] px-[var(--cr-gutter)] pb-[clamp(64px,9vw,130px)] flex flex-col gap-[clamp(24px,4vw,40px)] overflow-hidden [background:radial-gradient(60%_50%_at_85%_20%,color-mix(in_srgb,var(--cr-signal)_16%,transparent),transparent_70%),linear-gradient(var(--cr-line)_1px,transparent_1px)_0_0/100%_88px,var(--cr-ink)]">
    <p class="cr-label flex items-center gap-[14px] [color:var(--cr-signal)]" data-reveal>
      <span class="cr-led cr-led--signal cr-blink" aria-hidden="true"></span>Archivo de obra
    </p>

    <h1 class="[font-family:var(--cr-display)] font-black uppercase leading-[0.9] tracking-[-0.02em] text-[clamp(60px,8.6vw,140px)]" data-reveal style="--d:80ms">Proyec<span class="text-transparent [-webkit-text-stroke:1.5px_var(--cr-bone)]">tos.</span></h1>

    <div class="flex justify-between items-end flex-wrap gap-[clamp(24px,4vw,48px)] mt-[clamp(8px,2vw,16px)] max-sm:flex-col max-sm:items-start" data-reveal style="--d:160ms">
      <p class="max-w-[560px] text-[clamp(16px,1.4vw,20px)] leading-[1.6] [color:var(--cr-bone-dim)]">
        Centros comerciales, complejos residenciales, oficinas y naves industriales. Una muestra del
        trabajo que respalda cada presupuesto.
      </p>
      <dl class="flex gap-[clamp(28px,4vw,48px)] max-sm:gap-8">
        <div>
          <dd class="m-0 [font-family:var(--cr-display)] font-black text-[clamp(40px,6vw,88px)] leading-[0.9] [font-variant-numeric:tabular-nums]"><span data-count={CLIENTS}>{CLIENTS}</span></dd>
          <dt class="cr-label mt-1">Clientes</dt>
        </div>
        <div>
          <dd class="m-0 [font-family:var(--cr-display)] font-black text-[clamp(40px,6vw,88px)] leading-[0.9] [font-variant-numeric:tabular-nums]"><span data-count={DISCIPLINES}>{DISCIPLINES}</span></dd>
          <dt class="cr-label mt-1">Disciplinas</dt>
        </div>
      </dl>
    </div>
  </section>

  <!-- GRID -->
  <section id="proyectos" class="pt-[clamp(56px,8vw,120px)] pb-[clamp(72px,10vw,140px)] border-t border-[color:var(--cr-line)]">
    <div class="cr-wrap">
      <header class="mb-[clamp(32px,4vw,48px)]">
        <div>
          <p class="cr-label" data-reveal>01 — Casos de éxito</p>
          <h2 class="mt-[18px] text-[clamp(46px,6.4vw,96px)]" data-reveal style="--d:80ms">Trabajo <span class="text-transparent [-webkit-text-stroke:1.5px_var(--cr-bone)]">en el terreno.</span></h2>
        </div>
      </header>

      <div class="flex flex-wrap gap-[10px] mb-[clamp(32px,5vw,56px)]" data-reveal style="--d:120ms" role="group" aria-label="Filtrar proyectos por categoría">
        {
          chips.map((c, i) => (
            <button
              type="button"
              class="[font-family:var(--cr-mono)] text-sm font-semibold tracking-widest uppercase px-5 py-[10px] bg-transparent [color:var(--cr-bone-dim)] border border-[color:var(--cr-line-strong)] [clip-path:polygon(0_0,calc(100%-10px)_0,100%_10px,100%_100%,10px_100%,0_calc(100%-10px))] cursor-pointer transition-[background,color,border-color] duration-[250ms] hover:[color:var(--cr-bone)] hover:border-[color:var(--cr-bone-dim)] aria-pressed:[background:var(--cr-signal)] aria-pressed:[color:var(--cr-ink)] aria-pressed:border-[color:var(--cr-signal)]"
              data-filter-btn={c.filter}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {c.label}
            </button>
          ))
        }
      </div>

      <ul class="list-none m-0 p-0 grid grid-cols-3 gap-px [background:var(--cr-line)] border border-[color:var(--cr-line-strong)] max-[960px]:grid-cols-2 max-sm:grid-cols-1">
        {
          projects.map((p, i) => (
            <li class="group [background:var(--cr-ink-2)] flex flex-col [transition:background_0.4s,opacity_0.35s,transform_0.35s] [&[hidden]]:hidden" data-project data-filter={p.filter} data-reveal style={`--d:${i * 80}ms`}>
              <div class="relative aspect-[4/3] overflow-hidden">
                {typeof p.image === "string" ? (
                  <img class="w-full h-full object-cover block [filter:grayscale(0.55)_contrast(1.1)_brightness(0.85)] scale-[1.04] [transition:filter_0.6s,transform_0.9s_cubic-bezier(0.2,0.7,0.1,1)] group-hover:filter-none group-hover:scale-110" src={p.image} alt={p.title} loading="lazy" />
                ) : (
                  <Image class="w-full h-full object-cover block [filter:grayscale(0.55)_contrast(1.1)_brightness(0.85)] scale-[1.04] [transition:filter_0.6s,transform_0.9s_cubic-bezier(0.2,0.7,0.1,1)] group-hover:filter-none group-hover:scale-110" src={p.image} alt={p.title} loading="lazy" format="webp" />
                )}
                <span class="cr-label absolute left-[14px] top-[14px] py-[5px] px-[9px] [background:var(--cr-ink)] [color:var(--cr-signal)]">{p.code}</span>
              </div>
              <div class="pt-[22px] px-5 pb-[26px] flex flex-col gap-[10px] flex-1">
                <span class="cr-label inline-flex items-center gap-[10px] [color:var(--cr-signal)]">
                  <span class="cr-led cr-led--signal" aria-hidden="true"></span>
                  {p.category}
                </span>
                <h3 class="text-[clamp(24px,2.2vw,30px)]">{p.title}</h3>
                <p class="text-[16px] leading-[1.55] [color:var(--cr-bone-dim)]">{p.description}</p>
              </div>
            </li>
          ))
        }
      </ul>

      <p class="mt-8 [font-family:var(--cr-mono)] text-[14px] [color:var(--cr-bone-dim)] text-center" data-empty-state hidden>No hay proyectos en esta categoría todavía.</p>
    </div>
  </section>
  <!-- PLANNER -->
  <ProjectsPlanner />
</ControlRoomLayout>

<script>

  // Category filter chips — pure client-side show/hide, no framework
  const chipButtons = [...document.querySelectorAll<HTMLButtonElement>("[data-filter-btn]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-project]")];
  const emptyState = document.querySelector<HTMLElement>("[data-empty-state]");

  const applyFilter = (filter: string) => {
    let visibleCount = 0;
    cards.forEach((card) => {
      const matches = filter === "todos" || card.dataset.filter === filter;
      card.hidden = !matches;
      if (matches) visibleCount += 1;
    });
    if (emptyState) emptyState.hidden = visibleCount > 0;
  };

  chipButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      chipButtons.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
      applyFilter(btn.dataset.filterBtn ?? "todos");
    });
  });
</script>
