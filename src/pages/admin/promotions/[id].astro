---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getPromotionByIdAdmin, updatePromotion } from "@/services/admin";

const { id } = Astro.params;

if (!id) return Astro.redirect("/admin/promotions");

const { success, data: promo } = await getPromotionByIdAdmin(id);
if (!success || !promo) return Astro.redirect("/admin/promotions?flash=" + encodeURIComponent("error:Promoción no encontrada."));

let formError = "";
let fieldErrors: Record<string, string> = {};
let formValues = { ...promo };

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();

  const title = (form.get("title") as string)?.trim();
  const description = (form.get("description") as string)?.trim();
  const discount_type = form.get("discount_type") as "percentage" | "fixed";
  const discount_value = parseFloat(form.get("discount_value") as string);
  const promo_code = (form.get("promo_code") as string)?.trim().toUpperCase() || undefined;
  const start_date = form.get("start_date") as string;
  const end_date = form.get("end_date") as string;
  const is_active = form.get("is_active") === "1";
  const banner_image = (form.get("banner_image") as string)?.trim() || undefined;
  const terms = (form.get("terms") as string)?.trim() || undefined;
  const max_uses_raw = form.get("max_uses") as string;
  const max_uses = max_uses_raw ? parseInt(max_uses_raw) : undefined;
  const applicable_services = form.getAll("applicable_services") as string[];

  // Update preview values for re-render on error
  formValues = { ...formValues, title, description, discount_type, discount_value,
    promo_code, start_date, end_date, is_active, banner_image, terms, max_uses,
    applicable_services } as any;

  // Validation
  if (!title) fieldErrors.title = "El título es requerido";
  if (!description) fieldErrors.description = "La descripción es requerida";
  if (!discount_type) fieldErrors.discount_type = "Selecciona un tipo";
  if (isNaN(discount_value) || discount_value <= 0) fieldErrors.discount_value = "Ingresa un valor válido mayor a 0";
  if (!start_date) fieldErrors.start_date = "La fecha de inicio es requerida";
  if (!end_date) fieldErrors.end_date = "La fecha de fin es requerida";
  if (start_date && end_date && new Date(end_date) <= new Date(start_date)) {
    fieldErrors.end_date = "La fecha de fin debe ser posterior al inicio";
  }

  if (Object.keys(fieldErrors).length === 0) {
    const result = await updatePromotion(id, {
      title, description, discount_type, discount_value,
      promo_code, applicable_services, start_date, end_date,
      is_active, banner_image, terms, max_uses,
    });

    if (result.success) {
      return Astro.redirect("/admin/promotions?flash=" + encodeURIComponent("success:Promoción actualizada exitosamente."));
    } else {
      formError = result.error ?? "Error al actualizar la promoción";
    }
  }
}

// Format dates for datetime-local input
function toDatetimeLocal(dateStr: string | Date) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  const pad = (n: number) => String(n).padStart(2, "0");
  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
}

const startVal = toDatetimeLocal(formValues.start_date);
const endVal = toDatetimeLocal(formValues.end_date);
const services: string[] = Array.isArray(formValues.applicable_services)
  ? formValues.applicable_services
  : [];
---

<AdminLayout title="Editar Promoción" section="promotions">
  <style>
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      color: var(--text-muted);
      text-decoration: none;
      font-size: 12px;
      margin-bottom: 20px;
      transition: color 0.15s;
    }
    .back-link:hover { color: var(--text); }

    .form-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px;
      max-width: 760px;
    }

    .section-title {
      font-family: var(--font);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 3px;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .section-title::after { content: ''; flex: 1; height: 1px; background: var(--border); }

    .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px; }
    .form-grid.cols-1 { grid-template-columns: 1fr; }
    .form-grid.cols-3 { grid-template-columns: 1fr 1fr 1fr; }
    @media (max-width: 600px) { .form-grid, .form-grid.cols-3 { grid-template-columns: 1fr; } }
    .col-span-2 { grid-column: span 2; }

    .field { display: flex; flex-direction: column; gap: 6px; }

    label {
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    label .req { color: var(--red); margin-left: 2px; }

    input[type="text"],
    input[type="number"],
    input[type="url"],
    input[type="datetime-local"],
    select,
    textarea {
      padding: 10px 12px;
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      border-radius: 4px;
      color: var(--text);
      font-family: var(--font);
      font-size: 12px;
      outline: none;
      transition: border-color 0.2s;
      width: 100%;
    }
    input:focus, select:focus, textarea:focus {
      border-color: var(--primary);
      outline: 2px solid var(--primary);
      outline-offset: 2px;
      box-shadow: 0 0 0 3px rgba(205,92,92,0.1);
    }

    .field-error { font-size: 11px; color: var(--red); }
    input.has-error, select.has-error, textarea.has-error { border-color: rgba(244,63,94,0.4); }

    select {
      appearance: none;
      background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%2364748b' stroke-width='1.5' stroke-linecap='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: right 12px center;
      padding-right: 32px;
    }
    select option { background: #fff; }
    textarea { resize: vertical; min-height: 80px; }

    .checkbox-group { display: flex; gap: 10px; flex-wrap: wrap; }

    .checkbox-item {
      display: flex;
      align-items: center;
      gap: 7px;
      cursor: pointer;
      padding: 8px 12px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
      transition: all 0.15s;
    }
    .checkbox-item:has(input:checked) { background: var(--primary-dim); border-color: rgba(205,92,92,0.3); }
    .checkbox-item input[type="checkbox"] { width: 14px; height: 14px; accent-color: var(--accent); padding:0; border:none; background:none; }
    .checkbox-item span { font-size: 12px; color: var(--text-muted); font-family: var(--font); letter-spacing: 0.3px; }
    .checkbox-item:has(input:checked) span { color: var(--accent); }

    .toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 16px;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 4px;
    }
    .toggle-label { display: flex; flex-direction: column; gap: 2px; }
    .toggle-label strong { font-size: 13px; color: var(--text); font-family: var(--font); font-weight: 600; }
    .toggle-label small { font-size: 11px; color: var(--text-muted); }

    .switch { position: relative; width: 40px; height: 22px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; inset: 0; background: rgba(255,255,255,0.1); border-radius: 20px; cursor: pointer; transition: 0.2s; }
    .slider::before { content: ''; position: absolute; width: 16px; height: 16px; left: 3px; top: 3px; background: var(--text-muted); border-radius: 50%; transition: 0.2s; }
    .switch input:checked + .slider { background: var(--accent-dim); border: 1px solid rgba(205,92,92,0.3); }
    .switch input:checked + .slider::before { transform: translateX(18px); background: var(--accent); }

    .form-error {
      padding: 10px 14px;
      background: rgba(244,63,94,0.08);
      border: 1px solid rgba(244,63,94,0.25);
      color: var(--red);
      border-radius: var(--radius);
      font-size: 12px;
      margin-bottom: 20px;
    }

    .meta-info {
      display: flex;
      gap: 20px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .meta-item { font-size: 11px; color: var(--text-muted); }
    .meta-item strong { color: var(--text); font-family: var(--font); }

    .form-actions {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-top: 28px;
      padding-top: 20px;
      border-top: 1px solid var(--border);
    }

    .btn-submit {
      padding: 12px 28px;
      background: var(--accent);
      color: var(--bg);
      font-family: var(--font);
      font-size: 15px;
      font-weight: 700;
      letter-spacing: 1.5px;
      text-transform: uppercase;
      border: none;
      cursor: pointer;
      border-radius: var(--radius);
      transition: background 0.15s, transform 0.1s;
      box-shadow: 0 2px 8px rgba(205,92,92,0.25);
    }
    .btn-submit:hover { background: var(--primary-dark); transform: translateY(-1px); }
    .btn-submit:active { transform: translateY(0); }

    .btn-cancel {
      padding: 12px 20px;
      background: none;
      border: 1px solid var(--border);
      color: var(--text-muted);
      font-family: var(--font);
      font-size: 14px;
      cursor: pointer;
      border-radius: var(--radius);
      text-decoration: none;
      transition: all 0.15s;
    }
    .btn-cancel:hover { border-color: var(--border-hover); color: var(--text); }
  </style>

  <a href="/admin/promotions" class="back-link">
    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M10 3L4 8l6 5"/>
    </svg>
    Volver a Promociones
  </a>

  <!-- Meta info -->
  <div class="meta-info">
    <div class="meta-item">ID: <strong>{promo.id.slice(0, 8)}...</strong></div>
    <div class="meta-item">Usos actuales: <strong>{promo.current_uses}</strong></div>
    <div class="meta-item">Creada: <strong>{new Date(promo.created_at).toLocaleDateString("es-MX", { day:"2-digit", month:"short", year:"numeric" })}</strong></div>
  </div>

  {formError && <div class="form-error">⚠ {formError}</div>}

  <div class="form-card">
    <form method="POST">

      <!-- Información básica -->
      <div class="section-title">Información básica</div>
      <div class="form-grid">
        <div class="field col-span-2">
          <label for="title">Título <span class="req">*</span></label>
          <input
            type="text"
            id="title"
            name="title"
            value={formValues.title}
            class={fieldErrors.title ? "has-error" : ""}
          />
          {fieldErrors.title && <span class="field-error">{fieldErrors.title}</span>}
        </div>

        <div class="field col-span-2">
          <label for="description">Descripción <span class="req">*</span></label>
          <textarea
            id="description"
            name="description"
            class={fieldErrors.description ? "has-error" : ""}
          >{formValues.description}</textarea>
          {fieldErrors.description && <span class="field-error">{fieldErrors.description}</span>}
        </div>

        <div class="field">
          <label for="terms">Términos y condiciones</label>
          <textarea id="terms" name="terms">{formValues.terms}</textarea>
        </div>

        <div class="field">
          <label for="banner_image">URL de imagen (banner)</label>
          <input type="url" id="banner_image" name="banner_image" value={formValues.banner_image ?? ""} />
        </div>
      </div>

      <!-- Descuento -->
      <div class="section-title">Configuración del descuento</div>
      <div class="form-grid cols-3">
        <div class="field">
          <label for="discount_type">Tipo <span class="req">*</span></label>
          <select id="discount_type" name="discount_type" class={fieldErrors.discount_type ? "has-error" : ""}>
            <option value="percentage" selected={formValues.discount_type === "percentage"}>Porcentaje (%)</option>
            <option value="fixed" selected={formValues.discount_type === "fixed"}>Monto fijo (MXN)</option>
          </select>
          {fieldErrors.discount_type && <span class="field-error">{fieldErrors.discount_type}</span>}
        </div>

        <div class="field">
          <label for="discount_value">Valor <span class="req">*</span></label>
          <input
            type="number"
            id="discount_value"
            name="discount_value"
            min="0.01"
            step="0.01"
            value={formValues.discount_value}
            class={fieldErrors.discount_value ? "has-error" : ""}
          />
          {fieldErrors.discount_value && <span class="field-error">{fieldErrors.discount_value}</span>}
        </div>

        <div class="field">
          <label for="promo_code">Código promocional</label>
          <input
            type="text"
            id="promo_code"
            name="promo_code"
            value={formValues.promo_code ?? ""}
            style="text-transform:uppercase;letter-spacing:2px"
          />
        </div>

        <div class="field">
          <label for="max_uses">Máximo de usos</label>
          <input type="number" id="max_uses" name="max_uses" min="1" value={formValues.max_uses ?? ""} placeholder="Sin límite" />
        </div>
      </div>

      <!-- Vigencia -->
      <div class="section-title">Vigencia</div>
      <div class="form-grid">
        <div class="field">
          <label for="start_date">Fecha de inicio <span class="req">*</span></label>
          <input
            type="datetime-local"
            id="start_date"
            name="start_date"
            value={startVal}
            class={fieldErrors.start_date ? "has-error" : ""}
          />
          {fieldErrors.start_date && <span class="field-error">{fieldErrors.start_date}</span>}
        </div>

        <div class="field">
          <label for="end_date">Fecha de fin <span class="req">*</span></label>
          <input
            type="datetime-local"
            id="end_date"
            name="end_date"
            value={endVal}
            class={fieldErrors.end_date ? "has-error" : ""}
          />
          {fieldErrors.end_date && <span class="field-error">{fieldErrors.end_date}</span>}
        </div>
      </div>

      <!-- Servicios -->
      <div class="section-title">Servicios aplicables</div>
      <div class="form-grid cols-1" style="margin-bottom:24px">
        <div class="field">
          <div class="checkbox-group">
            <label class="checkbox-item">
              <input type="checkbox" name="applicable_services" value="fire-alarm" checked={services.includes("fire-alarm")} />
              <span>🔥 Alarma Contra Incendio</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="applicable_services" value="security" checked={services.includes("security")} />
              <span>📷 Seguridad / CCTV</span>
            </label>
            <label class="checkbox-item">
              <input type="checkbox" name="applicable_services" value="electricity" checked={services.includes("electricity")} />
              <span>⚡ Instalaciones Eléctricas</span>
            </label>
          </div>
          <small style="font-size:11px;color:var(--text-faint)">Si no seleccionas ninguno, aplica para todos los servicios.</small>
        </div>
      </div>

      <!-- Estado -->
      <div class="section-title">Estado</div>
      <div class="form-grid cols-1" style="margin-bottom:0">
        <div class="field">
          <div class="toggle-row">
            <div class="toggle-label">
              <strong>Promoción activa</strong>
              <small>Si está activa y dentro de la vigencia, se mostrará a los usuarios.</small>
            </div>
            <label class="switch">
              <input type="hidden" name="is_active" value="0" />
              <input type="checkbox" name="is_active" value="1" checked={formValues.is_active} />
              <span class="slider"></span>
            </label>
          </div>
        </div>
      </div>

      <!-- Actions -->
      <div class="form-actions">
        <button type="submit" class="btn-submit">Guardar Cambios</button>
        <a href="/admin/promotions" class="btn-cancel">Cancelar</a>
      </div>
    </form>
  </div>
</AdminLayout>
