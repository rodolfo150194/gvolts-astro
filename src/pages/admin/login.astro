---
export const prerender = false;

import { Image } from 'astro:assets';
import logoGvolts from "@/assets/img/logo/logo-gvoltscorp.png";

const ADMIN_COOKIE = "gv_admin";
const isLogout = Astro.url.searchParams.get("logout") === "1";
const errorParam = Astro.url.searchParams.get("error");

if (isLogout) {
  Astro.cookies.delete(ADMIN_COOKIE, { path: "/" });
  return Astro.redirect("/admin/login");
}

let formError = "";
if (errorParam === "config") {
  formError = "El servidor no está configurado correctamente.";
}

if (Astro.request.method === "POST") {
  const formData = await Astro.request.formData();
  const password = formData.get("password") as string;
  const adminPassword = import.meta.env.ADMIN_PASSWORD;

  if (!adminPassword) {
    formError = "El servidor no está configurado correctamente.";
  } else if (password === adminPassword) {
    const token = btoa(`gvolts:${adminPassword}`);
    Astro.cookies.set(ADMIN_COOKIE, token, {
      path: "/",
      httpOnly: true,
      secure: import.meta.env.PROD,
      sameSite: "lax",
      maxAge: 60 * 60 * 8,
    });
    return Astro.redirect("/admin");
  } else {
    formError = "Contraseña incorrecta.";
  }
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Acceso · GVolts Admin</title>
  <meta name="robots" content="noindex, nofollow" />
  <style>
    @font-face {
      font-family: 'Roboto Mono';
      src: url('/fonts/RobotoMono-VariableFont_wght.ttf') format('truetype');
      font-weight: 100 900;
      font-style: normal;
      font-display: swap;
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --primary:  #CD5C5C;
      --primary-dark: #B34545;
      --text:     #3D1F1D;
      --muted:    #7a5a58;
      --bg:       #FAF8F5;
      --border:   #e8e0df;
      --font:     'Roboto Mono', monospace;
    }

    body {
      min-height: 100dvh;
      background: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font);
      padding: 16px;
      position: relative;
    }

    /* Subtle dot pattern */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background-image: radial-gradient(circle, rgba(205,92,92,0.08) 1px, transparent 1px);
      background-size: 28px 28px;
      pointer-events: none;
    }

    .card {
      position: relative;
      width: 100%;
      max-width: 400px;
      padding: 40px 36px;
      background: #ffffff;
      border: 1px solid var(--border);
      border-radius: 10px;
      box-shadow: 0 4px 24px rgba(61,31,29,0.08), 0 1px 4px rgba(61,31,29,0.05);
    }

    /* Top accent strip */
    .card::before {
      content: '';
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--primary);
      border-radius: 10px 10px 0 0;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 32px;
    }

    .brand-logo {
      height: 38px;
      width: auto;
      object-fit: contain;
    }

    .brand-divider {
      width: 1px;
      height: 26px;
      background: var(--border);
    }

    .brand-label {
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--primary);
      font-family: var(--font);
    }

    h1 {
      font-family: var(--font);
      font-size: 18px;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 6px;
    }

    .subtitle {
      font-size: 11px;
      color: var(--muted);
      margin-bottom: 28px;
      letter-spacing: 0.3px;
    }

    label {
      display: block;
      font-size: 10px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--muted);
      margin-bottom: 8px;
    }

    input[type="password"] {
      width: 100%;
      padding: 11px 14px;
      background: var(--bg);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font);
      font-size: 14px;
      letter-spacing: 4px;
      outline: none;
      border-radius: 6px;
      transition: border-color 0.2s, box-shadow 0.2s;
      margin-bottom: 20px;
    }

    input[type="password"]:focus {
      border-color: var(--primary);
      outline: 2px solid var(--primary);
      outline-offset: 2px;
      box-shadow: 0 0 0 3px rgba(205,92,92,0.1);
    }

    input[type="password"]::placeholder {
      letter-spacing: 3px;
      color: #c4b0af;
    }

    .error {
      background: #fff5f5;
      border: 1px solid rgba(205,92,92,0.3);
      color: #b34545;
      font-size: 12px;
      padding: 10px 14px;
      border-radius: 6px;
      margin-bottom: 16px;
      letter-spacing: 0.3px;
    }

    button[type="submit"] {
      width: 100%;
      padding: 12px;
      background: var(--primary);
      color: #fff;
      font-family: var(--font);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 2px;
      text-transform: uppercase;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      transition: background 0.15s, transform 0.1s, box-shadow 0.15s;
      box-shadow: 0 2px 8px rgba(205,92,92,0.3);
    }

    button[type="submit"]:hover {
      background: var(--primary-dark);
      transform: translateY(-1px);
      box-shadow: 0 4px 14px rgba(205,92,92,0.35);
    }

    button[type="submit"]:active { transform: translateY(0); }

    .hint {
      margin-top: 20px;
      font-size: 10px;
      color: #c4b0af;
      text-align: center;
      letter-spacing: 1px;
    }

    @media (max-width: 480px) {
      .card { padding: 32px 24px; }
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="brand">
      <Image src={logoGvolts} alt="GVoltscorp" class="brand-logo" />
      <div class="brand-divider"></div>
      <span class="brand-label">Admin</span>
    </div>

    <h1>Acceso Restringido</h1>
    <p class="subtitle">Panel de administración · Solo personal autorizado</p>

    {formError && <div class="error">⚠ {formError}</div>}

    <form method="POST">
      <label for="password">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        placeholder="••••••••••••"
        autocomplete="current-password"
        required
        autofocus
      />
      <button type="submit">Ingresar</button>
    </form>

    <p class="hint">GVolts Corp · Sistema Interno</p>
  </div>
</body>
</html>
