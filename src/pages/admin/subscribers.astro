---
export const prerender = false;
import AdminLayout from "@/layouts/AdminLayout.astro";
import { getSubscribers, deleteSubscriber } from "@/services/admin";

let flash = "";

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = form.get("_action") as string;
  const id = parseInt(form.get("id") as string);

  if (action === "delete" && id) {
    const result = await deleteSubscriber(id);
    flash = result.success
      ? "success:Suscriptor eliminado correctamente."
      : "error:No se pudo eliminar el suscriptor.";
  }
  return Astro.redirect(
    `/admin/subscribers?flash=${encodeURIComponent(flash)}&page=${form.get("page") ?? 1}&q=${encodeURIComponent(form.get("q") as string ?? "")}`
  );
}

const page = parseInt(Astro.url.searchParams.get("page") ?? "1");
const search = Astro.url.searchParams.get("q") ?? "";
const flashParam = Astro.url.searchParams.get("flash") ?? "";

const { data: subscribers, total, pages } = await getSubscribers(page, search);
---

<AdminLayout title="Suscriptores" section="subscribers">
  <style>
    .toolbar {
      display: flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }

    .search-wrap {
      flex: 1;
      min-width: 220px;
      position: relative;
    }

    .search-wrap svg {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      padding: 9px 12px 9px 36px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      color: var(--text);
      font-family: var(--font);
      font-size: 12px;
      outline: none;
      transition: border-color 0.2s;
    }

    .search-input:focus {
      border-color: var(--primary);
      outline: 2px solid var(--primary);
      outline-offset: 2px;
    }

    .count-badge {
      font-size: 11px;
      color: var(--text-muted);
      white-space: nowrap;
    }

    .count-badge strong { color: var(--text); }

    /* ─── FLASH ─── */
    .flash {
      padding: 10px 14px;
      border-radius: var(--radius);
      font-size: 12px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .flash-success { background: rgba(22,163,74,0.07); border: 1px solid rgba(22,163,74,0.2); color: var(--green); }
    .flash-error   { background: rgba(244,63,94,0.08);  border: 1px solid rgba(244,63,94,0.2);  color: var(--red); }

    /* ─── TABLE ─── */
    .table-wrap {
      overflow-x: auto;
      border: 1px solid var(--border);
      border-radius: var(--radius);
    }

    table {
      width: 100%;
      border-collapse: collapse;
    }

    thead th {
      background: var(--bg);
      padding: 10px 16px;
      text-align: left;
      font-size: 9px;
      font-weight: 600;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--text-muted);
      border-bottom: 1px solid var(--border);
      white-space: nowrap;
    }

    tbody tr {
      border-bottom: 1px solid var(--border);
      transition: background 0.1s;
    }

    tbody tr:last-child { border-bottom: none; }
    tbody tr:hover { background: var(--bg-hover); }

    td {
      padding: 12px 16px;
      font-size: 12px;
      color: var(--text);
    }

    .td-id {
      color: var(--text-faint);
      font-family: var(--font);
      font-size: 11px;
      width: 60px;
    }

    .email-cell {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .email-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--accent-dim);
      border: 1px solid rgba(205,92,92,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font);
      font-size: 12px;
      font-weight: 700;
      color: var(--accent);
      text-transform: uppercase;
      flex-shrink: 0;
    }

    .email-link {
      color: var(--text);
      text-decoration: none;
    }

    .email-link:hover { color: var(--cyan); text-decoration: underline; }

    .td-date {
      color: var(--text-muted);
      font-family: var(--font);
      font-size: 11px;
      white-space: nowrap;
    }

    .td-actions { text-align: right; }

    .btn-delete {
      background: none;
      border: 1px solid transparent;
      color: var(--text-muted);
      cursor: pointer;
      padding: 5px 8px;
      border-radius: 4px;
      font-size: 11px;
      font-family: var(--font);
      transition: all 0.15s;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .btn-delete:hover {
      background: rgba(244,63,94,0.1);
      border-color: rgba(244,63,94,0.25);
      color: var(--red);
    }

    /* ─── EMPTY ─── */
    .empty {
      text-align: center;
      padding: 48px 24px;
      color: var(--text-muted);
    }

    .empty-icon {
      width: 48px;
      height: 48px;
      opacity: 0.15;
      margin: 0 auto 12px;
    }

    /* ─── PAGINATION ─── */
    .pagination {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 16px;
      flex-wrap: wrap;
      gap: 8px;
    }

    .page-info { font-size: 11px; color: var(--text-muted); }

    .page-buttons { display: flex; gap: 4px; }

    .page-btn {
      padding: 5px 10px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text);
      border-radius: 4px;
      font-family: var(--font);
      font-size: 11px;
      text-decoration: none;
      transition: all 0.15s;
    }

    .page-btn:hover { border-color: var(--border-hover); background: var(--bg-hover); }
    .page-btn.current { background: var(--accent-dim); border-color: rgba(205,92,92,0.3); color: var(--accent); }
    .page-btn[aria-disabled="true"] { opacity: 0.3; pointer-events: none; }

    /* ─── EXPORT ─── */
    .export-btn {
      padding: 9px 14px;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      border-radius: var(--radius);
      font-family: var(--font);
      font-size: 13px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 6px;
      text-decoration: none;
      transition: all 0.15s;
    }

    .export-btn:hover {
      border-color: var(--border-hover);
      color: var(--text);
    }
  </style>

  <!-- Flash -->
  {flashParam.startsWith("success:") && (
    <div class="flash flash-success">✓ {flashParam.slice(8)}</div>
  )}
  {flashParam.startsWith("error:") && (
    <div class="flash flash-error">⚠ {flashParam.slice(6)}</div>
  )}

  <!-- Toolbar -->
  <form class="toolbar" method="GET">
    <div class="search-wrap">
      <svg width="14" height="14" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <circle cx="7" cy="7" r="5"/><path d="M11 11l3 3"/>
      </svg>
      <input
        class="search-input"
        type="search"
        name="q"
        value={search}
        placeholder="Buscar por email..."
      />
    </div>
    <button type="submit" style="padding:9px 16px;background:var(--bg-card);border:1px solid var(--border);color:var(--text);border-radius:var(--radius);font-family:var(--font);font-size:13px;cursor:pointer;transition:all 0.15s">
      Buscar
    </button>
    <span class="count-badge"><strong>{total}</strong> suscriptores</span>

    <a
      href={`/admin/subscribers?export=csv&q=${search}`}
      class="export-btn"
    >
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <path d="M8 1v10M4 8l4 4 4-4"/><rect x="1" y="12" width="14" height="3" rx="1"/>
      </svg>
      CSV
    </a>
  </form>

  <!-- Table -->
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Email</th>
          <th>Fecha de suscripción</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {subscribers.length === 0 && (
          <tr>
            <td colspan="4">
              <div class="empty">
                <svg class="empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1">
                  <path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/>
                </svg>
                <p>No se encontraron suscriptores</p>
              </div>
            </td>
          </tr>
        )}
        {subscribers.map((s: any) => {
          const initial = s.email.charAt(0).toUpperCase();
          return (
            <tr>
              <td class="td-id">#{s.id}</td>
              <td>
                <div class="email-cell">
                  <div class="email-avatar">{initial}</div>
                  <a href={`mailto:${s.email}`} class="email-link">{s.email}</a>
                </div>
              </td>
              <td class="td-date">
                {new Date(s.created_at).toLocaleDateString("es-MX", {
                  day: "2-digit",
                  month: "long",
                  year: "numeric",
                  hour: "2-digit",
                  minute: "2-digit",
                })}
              </td>
              <td class="td-actions">
                <form method="POST">
                  <input type="hidden" name="_action" value="delete" />
                  <input type="hidden" name="id" value={s.id} />
                  <input type="hidden" name="page" value={page} />
                  <input type="hidden" name="q" value={search} />
                  <button
                    type="submit"
                    class="btn-delete"
                    onclick={`return confirm('¿Eliminar suscriptor ${s.email}?')`}
                  >
                    <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
                      <polyline points="3 6 5 6 13 6"/><path d="M14 6l-1 9H3L2 6"/>
                      <path d="M6 6V4h4v2"/>
                    </svg>
                    Eliminar
                  </button>
                </form>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- Pagination -->
  {pages > 1 && (
    <div class="pagination">
      <span class="page-info">
        Página {page} de {pages} · {total} registros
      </span>
      <div class="page-buttons">
        <a
          href={`/admin/subscribers?page=${page - 1}&q=${search}`}
          class="page-btn"
          aria-disabled={page <= 1 ? "true" : undefined}
        >← Ant</a>
        {Array.from({ length: Math.min(pages, 7) }, (_, i) => {
          const p = i + 1;
          return (
            <a
              href={`/admin/subscribers?page=${p}&q=${search}`}
              class={`page-btn ${p === page ? "current" : ""}`}
            >{p}</a>
          );
        })}
        <a
          href={`/admin/subscribers?page=${page + 1}&q=${search}`}
          class="page-btn"
          aria-disabled={page >= pages ? "true" : undefined}
        >Sig →</a>
      </div>
    </div>
  )}
</AdminLayout>
