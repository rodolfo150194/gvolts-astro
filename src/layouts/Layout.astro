---
import "@/styles/global.css";
import { SITE } from "@/data/site";

interface Props {
  title?: string;
  description?: string;
  /** Imagen para redes sociales (ruta relativa al sitio o URL absoluta). */
  image?: string;
  noindex?: boolean;
}

const {
  title = `${SITE.name} — Alarmas de incendio, seguridad y electricidad`,
  description = SITE.description,
  image = SITE.logo,
  noindex = false,
} = Astro.props;

const site = Astro.site ?? new URL(SITE.url);
const canonicalURL = new URL(Astro.url.pathname.replace(/(.)\/$/, "$1"), site);
const ogImageURL = new URL(image, site);
---

<!doctype html>
<html lang={SITE.locale} class="min-h-full w-full has-[.cr]:overflow-x-clip">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow, max-image-preview:large"} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/img/logo/logo-minimalista-gvolts.png" />
    <link rel="apple-touch-icon" href="/img/logo/logo-minimalista-gvolts.png" />
    <meta name="theme-color" content="#111012" />
    <meta name="color-scheme" content="dark" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Analítica y chat se cargan desde CookieConsent solo con consentimiento -->
    <slot name="head" />
  </head>
  <body class="min-h-screen w-full has-[.cr]:bg-[#111012] has-[.cr]:overflow-x-clip">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[200] focus:bg-white focus:text-indian-red-700 focus:px-4 focus:py-2 focus:rounded-lg focus:font-bold focus:shadow-lg focus:outline-none focus:ring-2 focus:ring-indian-red-500 focus:ring-offset-2"
      >Saltar al contenido</a
    >
    <slot />

    <script>
      // Navegación por ancla con desplazamiento suave (también al cargar con #hash)
      const scrollToHash = () => {
        const id = decodeURIComponent(window.location.hash.slice(1));
        if (!id) return;
        const target = document.getElementById(id);
        if (!target) return;
        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        target.scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "start" });
      };

      window.addEventListener("load", () => setTimeout(scrollToHash, 100), { once: true });
      window.addEventListener("hashchange", scrollToHash);
    </script>
  </body>
</html>
