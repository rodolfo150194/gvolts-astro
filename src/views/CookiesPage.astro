---
/**
 * Política de cookies (/cookies y /es/cookies). El cuerpo legal vive en un
 * componente por idioma (src/views/legal); título, entradilla e índice en src/i18n → cookiesPage.
 */
import LegalLayout from "@/layouts/LegalLayout.astro";
import CookiesEn from "@/views/legal/CookiesEn.astro";
import CookiesEs from "@/views/legal/CookiesEs.astro";
import { SITE } from "@/data/site";
import { fmt, getLocale, t } from "@/i18n";

const locale = getLocale(Astro);
const p = t(locale).cookiesPage;
const toc = Object.entries(p.toc).map(([id, label]) => ({ id, label }));
const Body = locale === "es" ? CookiesEs : CookiesEn;
---

<LegalLayout
  title={fmt(p.meta.title, { site: SITE.name })}
  description={p.meta.description}
  heading={p.heading}
  lede={p.lede}
  path="/cookies"
  toc={toc}
>
  <Body toc={p.toc} />
</LegalLayout>
