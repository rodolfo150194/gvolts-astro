---
/** Página de contacto (/contact y /es/contact). Textos en src/i18n → contact. */
import ControlRoomLayout from "@/layouts/ControlRoomLayout.astro";
import ContactPanel from "@/components/control-room/ContactPanel.astro";
import { CONTACT } from "@/data/company";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro).contact;
---

<ControlRoomLayout title={t.meta.title} description={t.meta.description} breadcrumbs={[{ name: t.breadcrumb, path: "/contact" }]}>
  <section class="relative [background:radial-gradient(60%_50%_at_85%_20%,color-mix(in_srgb,var(--cr-signal)_16%,transparent),transparent_70%),linear-gradient(var(--cr-line)_1px,transparent_1px)_0_0/100%_88px,var(--cr-ink)] [padding-block:clamp(48px,8vw,110px)_clamp(64px,9vw,130px)] max-sm:[padding-block:clamp(40px,10vw,72px)_clamp(88px,14vw,120px)]">
    <div class="cr-wrap grid grid-cols-2 max-[960px]:grid-cols-1 items-start [gap:clamp(40px,6vw,96px)]">
      <div class="flex flex-col gap-10">
        <p class="cr-label flex items-center gap-[14px] text-[var(--cr-signal)]" data-reveal>
          <span class="cr-led cr-blink"></span>{t.kicker}
        </p>

        <h1 class="[font-family:var(--cr-display)] font-black uppercase leading-[0.84] text-[clamp(60px,8.6vw,128px)]" data-reveal style="--d:80ms">
          {t.title1}<span class="text-transparent [-webkit-text-stroke:1.5px_var(--cr-bone)]">{t.title2}</span>
        </h1>

        <p class="max-w-[46ch] text-[clamp(17px,1.4vw,20px)] text-[var(--cr-bone-dim)]" data-reveal style="--d:160ms">
          {t.lede}
        </p>

        <div class="flex flex-col border-t border-[var(--cr-line-strong)]" data-reveal style="--d:240ms">
          <a class="flex justify-between items-center gap-4 py-6 border-b border-[var(--cr-line)] max-sm:flex-col max-sm:items-start max-sm:gap-[6px] text-[var(--cr-bone)] transition-colors duration-200 hover:text-[var(--cr-signal)]" href={CONTACT.phoneHref}>
            <span class="cr-label">{t.phone}</span>
            <span class="[font-family:var(--cr-display)] font-extrabold text-[clamp(24px,3vw,40px)]">{CONTACT.phone}</span>
          </a>
          <a class="flex justify-between items-center gap-4 py-6 border-b border-[var(--cr-line)] max-sm:flex-col max-sm:items-start max-sm:gap-[6px] text-[var(--cr-bone)] transition-colors duration-200 hover:text-[var(--cr-signal)]" href={`mailto:${CONTACT.email}`}>
            <span class="cr-label">{t.email}</span>
            <span class="[font-family:var(--cr-display)] font-extrabold text-[clamp(24px,3vw,40px)]">{CONTACT.email}</span>
          </a>
          <div class="flex justify-between items-center gap-4 py-6 border-b border-[var(--cr-line)] max-sm:flex-col max-sm:items-start max-sm:gap-[6px]">
            <span class="cr-label">{t.office}</span>
            <span class="[font-family:var(--cr-body)] font-normal text-[18px] text-right leading-[1.4] max-sm:text-left">{CONTACT.address[0]}<br />{CONTACT.address[1]}</span>
          </div>
        </div>

        <div class="flex items-center gap-6 p-7 bg-[var(--cr-signal)] text-[var(--cr-ink)] max-sm:flex-wrap" data-reveal style="--d:320ms">
          <span class="cr-led cr-led--signal cr-blink bg-[var(--cr-ink)] shadow-[0_0_0_3px_color-mix(in_srgb,var(--cr-ink)_22%,transparent),0_0_14px_var(--cr-ink)]"></span>
          <div class="grow">
            <p class="[font-family:var(--cr-display)] font-extrabold text-[30px] uppercase">{t.emergencyTitle}</p>
            <p class="text-[16px]">{t.emergencyText}</p>
          </div>
          <a href={CONTACT.phoneHref} class="cr-btn shrink-0 bg-[var(--cr-ink)] border-[var(--cr-ink)] text-[var(--cr-bone)] hover:bg-[var(--cr-bone)] hover:border-[var(--cr-bone)] hover:text-[var(--cr-ink)] max-sm:w-full max-sm:justify-center">{t.callNow}</a>
        </div>
      </div>

      <ContactPanel />
    </div>
  </section>
</ControlRoomLayout>
