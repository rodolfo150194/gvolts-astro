---
/**
 * Control Room icon set — schematic/technical line icons for the redesign brand.
 * Mirrors the alias-map pattern of @/components/old-version/Icon.astro, but every glyph is
 * hand-authored (24x24 grid, currentColor stroke, sharp corners) instead of Lucide,
 * per the design direction in memory topic design/control-room-icons-and-imagery.
 *
 * Usage: <IconCR name="flame-detector" />
 */
interface Props {
  name: string;
  size?: string | number;
  class?: string;
  strokeWidth?: number;
}

const { name, size = 24, class: className = "", strokeWidth = 1.75 } = Astro.props;

// Each entry is the inner markup of a 24x24 viewBox, stroke="currentColor" svg.
// Reuses two brand motifs throughout: the corner-tick blueprint mark (scan reticle)
// and the filled LED dot — same language as Nav's .cr-led and the .lift/.scan hovers.
const icons: Record<string, string> = {
  // 1. Smoke/fire detector — replaces flame-detector, fire-extinguisher
  "flame-detector": `
    <circle cx="12" cy="12" r="4" />
    <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
    <line x1="17.5" y1="6.5" x2="19.5" y2="4.5" />
    <line x1="6.5" y1="6.5" x2="4.5" y2="4.5" />
    <line x1="17.5" y1="17.5" x2="19.5" y2="19.5" />
    <line x1="6.5" y1="17.5" x2="4.5" y2="19.5" />
  `,
  // 2. Alarm zone panel with LED — replaces bell-alert, Bell/BellRing
  "alarm-panel": `
    <rect x="3" y="3" width="14" height="18" />
    <line x1="3" y1="9" x2="17" y2="9" />
    <line x1="3" y1="15" x2="17" y2="15" />
    <line x1="10" y1="3" x2="10" y2="21" />
    <circle cx="20" cy="5" r="2" fill="currentColor" stroke="none" />
  `,
  // 3. Camera with vision cone — replaces camera, Cctv
  "camera-cone": `
    <rect x="3" y="8" width="10" height="8" />
    <rect x="6" y="5" width="4" height="3" />
    <circle cx="8" cy="12" r="2" />
    <path d="M13 9 L21 4 M13 15 L21 20" stroke-dasharray="2 2" />
  `,
  // 4. Biometric reader panel — replaces fingerprint (scan-reticle motif, not organic print)
  "biometric-scan": `
    <path d="M3 8 V3 H8 M16 3 H21 V8 M21 16 V21 H16 M8 21 H3 V16" />
    <circle cx="12" cy="12" r="3.2" />
    <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
  `,
  // 5. Breaker + lightning bolt — replaces lightbulb-bolt, Zap
  "breaker-bolt": `
    <rect x="6" y="3" width="12" height="18" />
    <rect x="9.5" y="0.5" width="5" height="2.5" />
    <polygon points="13,6.5 9,13 12,13 11,17.5 15,11 12,11" fill="currentColor" stroke="none" />
  `,
  // 6. Network node + 3 lines — replaces network, cloud-check
  "network-node": `
    <circle cx="12" cy="12" r="2.5" />
    <circle cx="5" cy="6" r="2" />
    <circle cx="19" cy="6" r="2" />
    <circle cx="12" cy="20" r="2" />
    <line x1="10.2" y1="10.4" x2="6.4" y2="7.4" />
    <line x1="13.8" y1="10.4" x2="17.6" y2="7.4" />
    <line x1="12" y1="14.5" x2="12" y2="18" />
  `,
  // 7a. Shield + check — replaces shield-check
  "shield-check": `
    <path d="M12 3 L19 6 V11 C19 16 16 19.5 12 21 C8 19.5 5 16 5 11 V6 Z" />
    <polyline points="8.5,12 10.8,14.3 15,9.7" />
  `,
  // 7b. Shield + $ — replaces shield-dollar
  "shield-dollar": `
    <path d="M12 3 L19 6 V11 C19 16 16 19.5 12 21 C8 19.5 5 16 5 11 V6 Z" />
    <line x1="12" y1="7.5" x2="12" y2="16.5" />
    <path d="M14.5 9.2 C14.5 7.8 13.4 7.5 12 7.5 C10.6 7.5 9.5 8.1 9.5 9.2 C9.5 11.6 14.5 10.5 14.5 12.8 C14.5 14 13.4 14.5 12 14.5 C10.6 14.5 9.5 14.1 9.5 12.8" />
  `,
  // 7c. Shield + pulse — replaces shield-heart
  "shield-pulse": `
    <path d="M12 3 L19 6 V11 C19 16 16 19.5 12 21 C8 19.5 5 16 5 11 V6 Z" />
    <polyline points="7.5,13 9.5,13 10.5,9.5 12.5,16.5 13.5,13 16.5,13" />
  `,
  // 8. Gauge-style clock — replaces clock-fast, clock-check, phone-24
  "gauge-clock": `
    <circle cx="12" cy="12" r="8" />
    <line x1="12" y1="4" x2="12" y2="6" />
    <line x1="12" y1="18" x2="12" y2="20" />
    <line x1="4" y1="12" x2="6" y2="12" />
    <line x1="18" y1="12" x2="20" y2="12" />
    <line x1="12" y1="12" x2="12" y2="7.5" />
    <line x1="12" y1="12" x2="15" y2="13.5" />
    <circle cx="12" cy="12" r="0.9" fill="currentColor" stroke="none" />
  `,
  // 9. Technical seal — replaces certificate, award, award-star, file-certificate
  "tech-seal": `
    <circle cx="12" cy="9" r="6" />
    <polyline points="9,9 11,11 15,7" />
    <path d="M8 14.5 L6 21 L9.5 19 L12 21.5 L14.5 19 L18 21 L16 14.5" />
  `,
};

const inner = icons[name];

if (!inner) {
  console.warn(`IconCR "${name}" not found. Available: ${Object.keys(icons).join(", ")}`);
}
---

{
  inner && (
    <svg
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="square"
      stroke-linejoin="miter"
      class={className}
      aria-hidden="true"
      set:html={inner}
    />
  )
}
