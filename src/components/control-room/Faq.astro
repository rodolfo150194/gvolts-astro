---
/**
 * Preguntas frecuentes: resuelve las dudas que frenan una llamada.
 * Las respuestas solo repiten compromisos que la web ya publica
 * (visita sin costo, presupuesto en 24 h, garantía, central 24/7).
 */
import faqAvatar from "@/assets/img/avatar/faq.png";
import { useTranslations } from "@/i18n";

const t = useTranslations(Astro).faq;
const faqs = t.items;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<section class="faq py-[clamp(96px,12vw,160px)] border-t border-[var(--cr-line)]" id="preguntas">
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <div class="cr-wrap">
    <header class="mx-auto max-w-[760px] text-center">
      <p class="cr-label" data-reveal>{t.label}</p>
      <h2 class="mt-[18px] text-[clamp(44px,4.4vw,72px)]" data-reveal style="--d:80ms">
        {t.title1} <span class="text-transparent [-webkit-text-stroke:1.5px_var(--cr-bone)]">{t.title2}</span>
      </h2>
    </header>

    <div class="mt-[clamp(44px,6vw,76px)] grid grid-cols-2 gap-x-[clamp(24px,4vw,56px)] gap-y-0 max-[820px]:grid-cols-1" data-reveal style="--d:120ms">
      {
        [faqs.slice(0, 3), faqs.slice(3)].map((column, columnIndex) => (
          <div class="border-t border-[var(--cr-line-strong)]">
            {column.map((f, faqIndex) => (
              <div class="relative border-b border-[var(--cr-line)]">
                {columnIndex === 1 && faqIndex === 0 && (
                  <img
                    src={faqAvatar.src}
                    alt=""
                    aria-hidden="true"
                    loading="lazy"
                    decoding="async"
                    class="pointer-events-none absolute -top-24 right-3 z-10 w-[clamp(96px,12vw,164px)] select-none drop-shadow-[0_18px_34px_rgba(0,0,0,0.35)] max-[820px]:-top-16 max-[820px]:right-2 max-[820px]:w-28"
                  />
                )}
                <details class="group">
                  <summary class="flex min-h-[104px] items-center justify-between gap-6 py-6 cursor-pointer list-none [&::-webkit-details-marker]:hidden [font-family:var(--cr-display)] font-bold text-[clamp(20px,1.8vw,26px)] leading-[1.2] transition-colors duration-200 hover:text-[var(--cr-signal)] max-[640px]:min-h-0">
                    {f.q}
                    <span class="shrink-0 grid place-items-center w-9 h-9 border border-[var(--cr-line-strong)] text-[var(--cr-signal)] text-[20px] transition-transform duration-300 group-open:rotate-45" aria-hidden="true">+</span>
                  </summary>
                  <p class="pb-6 pr-14 text-[18px] leading-[1.65] text-[var(--cr-bone-dim)] max-[640px]:pr-0">{f.a}</p>
                </details>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>
</section>
