---
import ServiceCircuit from "@/components/control-room/ServiceCircuit.astro";
import iconFire from "@/assets/img/icons/toolts-fire.png";
import iconSecurity from "@/assets/img/icons/cctv.png";
import iconElectric from "@/assets/img/icons/toolts-electric.png";
import { Image } from "astro:assets";

const tabs = [
  { key: "fire", label: "Incendio", icon: iconFire, accent: "#ff6b35" },
  { key: "security", label: "Seguridad", icon: iconSecurity, accent: "#4da8ff" },
  { key: "elec", label: "Electricidad", icon: iconElectric, accent: "#ffd66b" },
] as const;
---

<section class="process pt-[clamp(96px,12vw,180px)] pb-[clamp(64px,8vw,100px)]" id="proceso">
  <div class="cr-wrap flex justify-center">
    <div class="flex border border-[var(--cr-line-strong)] shrink-0" role="tablist" aria-label="Servicio" data-reveal>
      {
        tabs.map((t, i) => (
          <button
            type="button"
            role="tab"
            class="appearance-none flex items-center gap-2.5 h-[56px] px-[22px] border-0 bg-transparent text-[var(--cr-bone-dim)] [font-family:var(--cr-mono)] text-[14px] tracking-[0.12em] uppercase cursor-pointer transition-[background-color,color] duration-200 hover:text-[var(--cr-bone)] aria-selected:bg-[var(--tab-accent)] aria-selected:text-[var(--cr-ink)]"
            aria-selected={i === 0 ? "true" : "false"}
            data-proc-tab={t.key}
            style={`--tab-accent:${t.accent}`}
          >
            <Image src={t.icon} alt="" width={64} height={64} class="shrink-0 w-[28px] h-[28px] object-contain" />
            {t.label}
          </button>
        ))
      }
    </div>
  </div>

  <div class="mt-[clamp(40px,5vw,56px)]">
    {
      tabs.map((t, i) => (
        <div class="process__panel" data-proc-panel={t.key} hidden={i !== 0}>
          <ServiceCircuit service={t.key} num="02" />
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Cada panel recolorea --cr-signal al tono del servicio, aunque la página
     (index) no tenga su propio data-accent. */
  .process__panel[data-proc-panel="fire"] { --cr-signal: #ff6b35; --cr-signal-deep: #d9481f; }
  .process__panel[data-proc-panel="security"] { --cr-signal: #4da8ff; --cr-signal-deep: #2f7fd1; }
  .process__panel[data-proc-panel="elec"] { --cr-signal: #ffd66b; --cr-signal-deep: #e0b23a; }
</style>

<script>
  // Servicio activo en la sección "Método" (fuego / seguridad / electricidad)
  const tabButtons = document.querySelectorAll<HTMLButtonElement>("[data-proc-tab]");
  const panels = document.querySelectorAll<HTMLElement>("[data-proc-panel]");

  tabButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const target = btn.dataset.procTab;
      tabButtons.forEach((b) => b.setAttribute("aria-selected", String(b === btn)));
      panels.forEach((p) => {
        p.hidden = p.dataset.procPanel !== target;
      });
    });
  });
</script>
