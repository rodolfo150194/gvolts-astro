---
/**
 * Telemetría de la operación — 4 "instrumentos", cada uno con su propio
 * estilo de medidor y color de la paleta control-room.
 * Métricas de una empresa que está arrancando: actualiza CLIENTS a mano
 * cuando entre un cliente nuevo (la matriz de LEDs crece sola).
 */
const CLIENTS = 12; // clientes activos reales — mantener al día

// CH-01 · matriz de LEDs: 1 LED encendido = 1 cliente
const COLS = 8, GAP = 26, R = 7;
const slots = Math.max(32, Math.ceil(CLIENTS / COLS) * COLS);
const rows = slots / COLS;
const dotX0 = (240 - (COLS - 1) * GAP) / 2;
const dotsH = rows * GAP + 28;

// CH-02 · arco en 3 segmentos (una disciplina por segmento)
const services = [
  { tag: "SEG", x: 57.6, y: 88 },
  { tag: "INC", x: 120, y: 52 },
  { tag: "ELE", x: 182.4, y: 88 },
];

// CH-04 · barra lineal de 24 celdas (1 celda = 1 mes)
const MONTHS = 24;
const cellW = 200 / MONTHS;
---

<section class="telemetry border-y border-[var(--cr-line)] bg-[var(--cr-ink-2)] py-[clamp(48px,6vw,72px)]">
  <div class="cr-wrap">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-7" data-reveal>
      <p class="cr-label inline-flex items-center gap-3"><span class="cr-led"></span>Telemetría de la operación</p>
      <p class="cr-label" aria-hidden="true">GV-OPS · CH 01–04</p>
    </div>

    <div class="tm__grid grid grid-cols-4 gap-6 max-[1100px]:grid-cols-2 max-[560px]:grid-cols-1">
      <!-- CH-01 · Clientes: matriz de LEDs -->
      <div class="tm__card" data-reveal style="--g:var(--cr-ok);--d:0ms">
        <p class="tm__ch"><span>CH-01</span><span>CARTERA</span></p>
        <svg class="tm__svg" viewBox={`0 0 240 ${dotsH}`} aria-hidden="true">
          {
            Array.from({ length: slots }, (_, i) => (
              <circle
                class={i < CLIENTS ? "tm__led" : undefined}
                cx={dotX0 + (i % COLS) * GAP}
                cy={16 + Math.floor(i / COLS) * GAP}
                r={R}
                fill={i < CLIENTS ? "var(--g)" : "var(--cr-line)"}
                style={i < CLIENTS ? `--i:${i}` : undefined}
              />
            ))
          }
          <text x="120" y={dotsH - 4} class="tm__cap" text-anchor="middle">1 LED = 1 CLIENTE</text>
        </svg>
        <p class="tm__label">Clientes activos</p>
        <p class="tm__value"><span data-count={CLIENTS}>{CLIENTS}</span></p>
        <p class="tm__note">Cada uno con nombre y apellido. Estamos empezando.</p>
      </div>

      <!-- CH-02 · Disciplinas: arco segmentado -->
      <div class="tm__card" data-reveal style="--g:#4da8ff;--d:80ms">
        <p class="tm__ch"><span>CH-02</span><span>DISCIPLINAS</span></p>
        <svg class="tm__svg" viewBox="0 0 240 140" aria-hidden="true">
          {
            services.map((s, i) => (
              <>
                <path d="M20 120 A100 100 0 0 1 220 120" fill="none" stroke="var(--cr-line)" stroke-width="26" pathLength="100" stroke-dasharray={`0 ${i * 33.34 + 1} 31.33 100`} />
                <path class="tm__seg" d="M20 120 A100 100 0 0 1 220 120" fill="none" stroke="var(--g)" stroke-width="26" pathLength="100" stroke-dasharray={`0 ${i * 33.34 + 1} 31.33 100`} style={`--i:${i}`} />
                <text x={s.x} y={s.y} class="tm__cap tm__cap--g" text-anchor="middle">{s.tag}</text>
              </>
            ))
          }
          <text x="120" y="134" class="tm__cap" text-anchor="middle">UN SOLO CONTRATISTA</text>
        </svg>
        <p class="tm__label">Servicios bajo un mismo equipo</p>
        <p class="tm__value"><span data-count="3">3</span></p>
        <p class="tm__note">Seguridad, incendio y electricidad.</p>
      </div>

      <!-- CH-03 · Respuesta de la central: cronómetro -->
      <div class="tm__card" data-reveal style="--g:var(--cr-signal);--d:160ms">
        <p class="tm__ch"><span>CH-03</span><span>RESPUESTA</span></p>
        <svg class="tm__svg" viewBox="0 0 240 140" aria-hidden="true">
          <rect x="112" y="4" width="16" height="8" fill="var(--cr-bone-dim)" />
          <circle cx="120" cy="74" r="58" fill="none" stroke="var(--cr-line)" stroke-width="10" />
          <circle class="tm__sweep" cx="120" cy="74" r="58" fill="none" stroke="var(--g)" stroke-width="10" pathLength="60" stroke-dasharray="30 60" transform="rotate(-90 120 74)" />
          <circle cx="120" cy="74" r="58" fill="none" stroke="var(--cr-ink-2)" stroke-width="12" pathLength="60" stroke-dasharray="0.3 4.7" transform="rotate(-90 120 74)" />
          <text x="120" y="36" class="tm__cap" text-anchor="middle">0</text>
          <text x="112" y="116" class="tm__cap tm__cap--g" text-anchor="end">30s</text>
          <g class="tm__hand"><line x1="120" y1="74" x2="120" y2="30" stroke="var(--cr-bone)" stroke-width="3" stroke-linecap="round" /></g>
          <circle cx="120" cy="74" r="7" fill="var(--cr-ink)" stroke="var(--cr-bone)" stroke-width="2" />
        </svg>
        <p class="tm__label">Respuesta de la central 24/7</p>
        <p class="tm__value"><span class="text-[var(--g)]">&lt;</span>30<span class="tm__unit">s</span></p>
        <p class="tm__note">Central certificada UL, todos los días.</p>
      </div>

      <!-- CH-04 · Garantía: barra lineal por meses -->
      <div class="tm__card" data-reveal style="--g:var(--cr-amber);--d:240ms">
        <p class="tm__ch"><span>CH-04</span><span>GARANTÍA</span></p>
        <svg class="tm__svg" viewBox="0 0 240 140" aria-hidden="true">
          {
            Array.from({ length: MONTHS }, (_, i) => (
              <>
                <rect x={20 + i * cellW} y="46" width={cellW - 2} height="40" fill="var(--cr-line)" />
                <rect class="tm__cell" x={20 + i * cellW} y="46" width={cellW - 2} height="40" fill="var(--g)" style={`--i:${i}`} />
              </>
            ))
          }
          <line x1="20" y1="92" x2="20" y2="100" stroke="var(--cr-bone-dim)" />
          <line x1="119" y1="92" x2="119" y2="100" stroke="var(--cr-bone-dim)" />
          <line x1="218" y1="92" x2="218" y2="100" stroke="var(--cr-bone-dim)" />
          <text x="20" y="114" class="tm__cap" text-anchor="middle">0</text>
          <text x="119" y="114" class="tm__cap" text-anchor="middle">12</text>
          <text x="218" y="114" class="tm__cap" text-anchor="middle">24</text>
          <text x="120" y="134" class="tm__cap tm__cap--g" text-anchor="middle">1 CELDA = 1 MES</text>
        </svg>
        <p class="tm__label">Garantía en mano de obra</p>
        <p class="tm__value"><span data-count="2">2</span><span class="tm__unit"> años</span></p>
        <p class="tm__note">Por escrito, en cada instalación.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .tm__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 24px;
    background: var(--cr-ink);
    border: 1px solid var(--cr-line);
    text-align: center;
  }

  /* Filete de color arriba: identifica el canal */
  .tm__card::before {
    content: "";
    position: absolute;
    inset: -1px -1px auto;
    height: 3px;
    background: var(--g);
  }

  .tm__ch {
    align-self: stretch;
    display: flex;
    justify-content: space-between;
    font-family: var(--cr-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    color: var(--cr-bone-dim);
  }

  .tm__ch span:last-child {
    color: var(--g);
  }

  .tm__svg {
    width: 100%;
    max-width: 240px;
    height: auto;
    overflow: visible;
  }

  .tm__cap {
    font-family: var(--cr-mono);
    font-size: 10px;
    letter-spacing: 0.12em;
    fill: var(--cr-bone-dim);
  }

  .tm__cap--g {
    fill: var(--g);
  }

  /* La etiqueta va debajo del número visualmente */
  .tm__label {
    order: 3;
    font-size: 15px;
    color: var(--cr-bone);
  }

  .tm__value {
    order: 2;
    margin: 0;
    font-family: var(--cr-display);
    font-weight: 900;
    font-size: clamp(64px, 6vw, 96px);
    line-height: 0.85;
    font-variant-numeric: tabular-nums;
  }

  .tm__unit {
    font-size: 0.5em;
    color: var(--g);
  }

  .tm__note {
    order: 4;
    font-size: 13px;
    line-height: 1.45;
    color: var(--cr-bone-dim);
  }

  /* ── Animaciones: arrancan cuando la tarjeta entra (.is-in) ── */
  .tm__led,
  .tm__seg,
  .tm__cell {
    opacity: 0;
    transition: opacity 0.25s ease;
    transition-delay: calc(400ms + var(--i) * var(--step, 60ms));
  }

  .tm__seg {
    --step: 280ms;
  }

  .tm__cell {
    --step: 45ms;
  }

  .is-in .tm__led,
  .is-in .tm__seg,
  .is-in .tm__cell {
    opacity: 1;
  }

  .tm__sweep {
    stroke-dashoffset: 30;
    transition: stroke-dashoffset 1.6s cubic-bezier(0.2, 0.9, 0.3, 1) 400ms;
  }

  .is-in .tm__sweep {
    stroke-dashoffset: 0;
  }

  .tm__hand {
    transform-origin: 120px 74px;
    transform: rotate(0deg);
    transition: transform 1.6s cubic-bezier(0.2, 0.9, 0.3, 1.1) 400ms;
  }

  .is-in .tm__hand {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .tm__led,
    .tm__seg,
    .tm__cell {
      opacity: 1;
    }

    .tm__sweep {
      stroke-dashoffset: 0;
    }

    .tm__hand {
      transform: rotate(180deg);
    }
  }
</style>
