---
/**
 * Circuito por servicio — 5 nodos conectados por trazas de "corriente".
 * El paso activo avanza solo; el usuario puede elegir un nodo o usar
 * anterior/siguiente (la reproducción automática se reanuda a los 10 s).
 * El color de acento es el `--cr-signal` de la página (data-accent).
 */
type Service = "security" | "fire" | "elec";

interface Props {
  service: Service;
  num?: string;
  stepMs?: number;
}

const { service, num = "02", stepMs = 2200 } = Astro.props;

interface Step {
  title: string;
  tag: string;
  desc: string;
  why: string;
  spec: string;
  icon: string;
}

const DATA: Record<Service, { eyebrow: string; title: string; titleOutline: string; steps: Step[] }> = {
  security: {
    eyebrow: "Cómo funciona",
    title: "Así protege",
    titleOutline: "tu sistema.",
    steps: [
      { title: "Detecta", tag: "CÁMARAS 4K", desc: "Cámaras 4K con visión nocturna vigilan cada acceso y perímetro, de día y de noche.", why: "Imagen nítida hasta 30 m en oscuridad total.", spec: "8MP · IR 30 m · IP67 · WDR 120dB", icon: "M3 7h11v10H3zM14 11l7-4v10l-7-4" },
      { title: "Analiza", tag: "IA INCORPORADA", desc: "La IA distingue personas, vehículos y placas, y descarta sombras, animales y lluvia.", why: "99% menos eventos falsos: solo te alerta cuando importa.", spec: "Facial 1:N · LPR/ANPR · Líneas virtuales", icon: "M12 3l1.9 5.8L20 10l-6.1 1.2L12 17l-1.9-5.8L4 10l6.1-1.2z" },
      { title: "Notifica", tag: "APP MÓVIL", desc: "Recibes el clip del evento en tu móvil en segundos, estés donde estés.", why: "Ves lo que pasa y decides al momento.", spec: "iOS · Android · Web", icon: "M8 2h8a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2zM12 18h.01" },
      { title: "Controla", tag: "ACCESO BIOMÉTRICO", desc: "Huella, rostro, tarjeta o móvil abren solo a quien autorizas, en el horario que defines.", why: "Solo quien tú decidas, cuando tú decidas.", spec: "Failsafe / Failsecure · 10,000 usuarios", icon: "M6 11h12v10H6zM8 11V7a4 4 0 0 1 8 0v4M12 15v2" },
      { title: "Resguarda", tag: "LOCAL + NUBE", desc: "Todo queda grabado y registrado en disco local y en la nube cifrada.", why: "Evidencia disponible y protegida contra accesos indebidos.", spec: "RAID 5 · 30 días · AES-256 · VPN", icon: "M17.5 19H9a7 7 0 1 1 6.7-9h1.8a4.5 4.5 0 1 1 0 9z" },
    ],
  },
  fire: {
    eyebrow: "Cómo funciona",
    title: "Del humo",
    titleOutline: "a la respuesta.",
    steps: [
      { title: "Detecta", tag: "MULTI-SENSOR", desc: "Humo fotoeléctrico, calor y CO combinados distinguen una tostada de un incendio real.", why: "Reducción del 95% en falsas alarmas.", spec: "Fotoeléctrico · Calor · CO", icon: "M4 8h16M6 8v2a6 6 0 0 0 12 0V8M9 16l-1 3M15 16l1 3M12 17v3" },
      { title: "Ubica", tag: "PANEL DIRECCIONABLE", desc: "El panel identifica la ubicación exacta del evento en segundos.", why: "Evacuación por zona, sin pánico general.", spec: "Mapeo en tiempo real · UL 864", icon: "M12 22s7-6.5 7-12a7 7 0 0 0-14 0c0 5.5 7 12 7 12zM12 12.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" },
      { title: "Alerta", tag: "SIRENAS + ESTROBOS", desc: "Sirenas estroboscópicas sincronizadas y mensajes de voz alertan a todos al instante.", why: "Nadie se queda sin enterarse, incluidas personas con discapacidad auditiva.", spec: "NFPA 72 · ADA · Voz pregrabada", icon: "M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9M10.3 21a1.9 1.9 0 0 0 3.4 0" },
      { title: "Suprime", tag: "SUPRESIÓN", desc: "Rociadores, gas limpio FM-200 y control de humo responden de forma automática.", why: "Se minimizan los daños antes de que llegue ayuda.", spec: "Rociadores · FM-200 · Compuertas", icon: "M12 2.7l5.7 5.7a8 8 0 1 1-11.4 0z" },
      { title: "Monitorea", tag: "CENTRAL UL 24/7", desc: "La central certificada recibe la señal y despacha ayuda mientras verifica.", why: "Respuesta en menos de 30 segundos, 24/7.", spec: "Central UL · Batería de respaldo 72 h", icon: "M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a9 9 0 0 1 18 0v7a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3" },
    ],
  },
  elec: {
    eyebrow: "Cómo funciona",
    title: "De la acometida",
    titleOutline: "a cada toma.",
    steps: [
      { title: "Acometida", tag: "DEMANDA", desc: "Calculamos la demanda y coordinamos con la compañía eléctrica desde el origen.", why: "Tu instalación queda dimensionada para lo que realmente consumes.", spec: "Cálculo de demanda · Planos sellados", icon: "M12 2v20M5 6h14M7 10h10M5 6l2 4M19 6l-2 4M9 22h6" },
      { title: "Tablero", tag: "PANEL 200–400 A", desc: "Paneles modernos con espacio para crecer y puesta a tierra correcta.", why: "Capacidad para vehículo eléctrico, ampliaciones y equipos nuevos.", spec: "200 A · 400 A · Transferencia sin interrupción", icon: "M4 3h16v18H4zM8 7h3M13 7h3M8 11h3M13 11h3M8 15h3M13 15h3" },
      { title: "Protege", tag: "AFCI · GFCI", desc: "Breakers AFCI/GFCI y pruebas de continuidad, aislamiento, polaridad y tierra antes de energizar.", why: "Se previenen arcos, descargas e incendios de origen eléctrico.", spec: "AFCI · GFCI · Pruebas antes de energizar", icon: "M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10zM9 12l2 2 4-4" },
      { title: "Distribuye", tag: "CIRCUITOS NEC", desc: "Líneas dedicadas con el calibre correcto para cada equipo de alto consumo.", why: "Aprobado por el inspector sin observaciones.", spec: "Calibre según NEC · EV 240 V · Mini-split", icon: "M9 2v6M15 2v6M6 8h12v4a6 6 0 0 1-12 0zM12 18v4" },
      { title: "Respalda", tag: "ATS · UPS", desc: "Transfer switch automático, generadores y UPS mantienen tu operación en apagones.", why: "Tus equipos críticos no se detienen.", spec: "Transfer automático · Diésel / gas · UPS", icon: "M3 7h15v10H3zM21 10v4M11 9l-3 4h4l-1 3" },
    ],
  },
};

const D = DATA[service] ?? DATA.security;
const pad = (n: number) => String(n).padStart(2, "0");

// Geometría del circuito (px del diseño sobre un lienzo de 1312 × 250),
// convertida a % horizontal para que escale con el ancho del contenedor.
const CW = 1312, NW = 208, NH = 88, T = 6;
const pos = [[0, 24], [276, 146], [552, 24], [828, 146], [1104, 24]];
const pct = (v: number) => `${((v / CW) * 100).toFixed(4)}%`;

const traces: { seg: number; horiz: boolean; style: string }[] = [];
for (let i = 0; i < 4; i++) {
  const [x1, y1] = pos[i], [x2, y2] = pos[i + 1];
  const ax = x1 + NW, ay = y1 + NH / 2 - T / 2;
  const bx = x2, by = y2 + NH / 2 - T / 2;
  const mid = Math.round((ax + bx) / 2);
  traces.push({ seg: i, horiz: true, style: `left:${pct(ax)};top:${ay}px;width:${pct(mid - ax)};height:${T}px` });
  traces.push({ seg: i, horiz: false, style: `left:calc(${pct(mid)} - ${T / 2}px);top:${Math.min(ay, by)}px;width:${T}px;height:${Math.abs(by - ay) + T}px` });
  traces.push({ seg: i, horiz: true, style: `left:${pct(mid)};top:${by}px;width:${pct(bx - mid)};height:${T}px` });
}
---

<section class="sc" data-circuit data-step-ms={stepMs} aria-label={`${D.title} ${D.titleOutline}`}>
  <div class="cr-wrap sc__wrap">
    <header class="sc__head">
      <div class="flex flex-col gap-[18px]">
        <p class="cr-label text-[var(--cr-signal)]" data-reveal>{num} — {D.eyebrow}</p>
        <h2 class="sc__title" data-reveal style="--d:80ms">
          {D.title} <span class="text-transparent [-webkit-text-stroke:1.5px_var(--cr-bone)]">{D.titleOutline}</span>
        </h2>
      </div>
      <div class="sc__meter" aria-hidden="true">
        <p class="cr-label flex items-center gap-2"><span class="sc__blink"></span>Circuito activo</p>
        <p class="sc__pct"><span data-circuit-pct>20</span><small>%</small></p>
      </div>
    </header>

    <div class="sc__board">
      {traces.map((t) => <span class={`sc__trace ${t.horiz ? "sc__trace--h" : "sc__trace--v"}`} data-seg={t.seg} style={t.style} aria-hidden="true" />)}

      <ol class="sc__nodes">
        {
          D.steps.map((st, i) => (
            <li class="sc__item" style={`--x:${pct(pos[i][0])};--y:${pos[i][1]}px;--w:${pct(NW)}`}>
              <button
                class="sc__node"
                type="button"
                data-node={i}
                aria-pressed={i === 0 ? "true" : "false"}
                aria-label={`Paso ${i + 1}: ${st.title}`}
                data-state={i === 0 ? "here" : "todo"}
              >
                <span class="sc__pulse" aria-hidden="true" />
                <span class="sc__icon" aria-hidden="true">
                  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={st.icon} /></svg>
                </span>
                <span class="flex flex-col gap-1 min-w-0">
                  <span class="sc__node-title">{st.title}</span>
                  <span class="sc__node-tag">{pad(i + 1)} · {st.tag}</span>
                </span>
                <span class="sc__pin sc__pin--tl" aria-hidden="true" />
                <span class="sc__pin sc__pin--tr" aria-hidden="true" />
                <span class="sc__pin sc__pin--bl" aria-hidden="true" />
                <span class="sc__pin sc__pin--br" aria-hidden="true" />
              </button>
              {i < D.steps.length - 1 && <span class="sc__link" data-seg={i} aria-hidden="true" />}
            </li>
          ))
        }
      </ol>
    </div>

    <div class="sc__detail">
      <div class="sc__panels" aria-live="polite">
        {
          D.steps.map((st, i) => (
            <div class="sc__panel" data-panel={i} hidden={i !== 0}>
              <div class="sc__rise flex flex-col gap-[10px]">
                <h3 class="sc__cur-title">
                  <span class="sc__cur-icon" aria-hidden="true">
                    <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d={st.icon} /></svg>
                  </span>
                  {pad(i + 1)} · {st.title}
                </h3>
                <p class="max-w-[560px] text-[18px] leading-[1.55] text-[var(--cr-bone-dim)]">{st.desc}</p>
              </div>
              <div class="sc__rise sc__why">
                <p class="cr-label text-[var(--cr-signal)]">Por qué importa</p>
                <p class="text-[18px] font-semibold leading-[1.45]">{st.why}</p>
                <p class="[font-family:var(--cr-mono)] text-[14px] text-[var(--cr-bone-dim)]">{st.spec}</p>
              </div>
            </div>
          ))
        }
      </div>
      <div class="sc__nav">
        <button class="sc__btn" type="button" data-circuit-next aria-label="Paso siguiente">Siguiente →</button>
        <button class="sc__btn sc__btn--dim" type="button" data-circuit-prev aria-label="Paso anterior">← Anterior</button>
      </div>
    </div>
  </div>
</section>

<style>
  .sc {
    padding-block: clamp(72px, 8vw, 88px);
    background-color: #0b0a0c;
    background-image: radial-gradient(rgba(237, 232, 224, 0.08) 1px, transparent 1px);
    background-size: 22px 22px;
    border-top: 1px solid var(--cr-line);
    overflow: clip;
  }
  .sc__wrap { display: flex; flex-direction: column; gap: 36px; }
  .sc__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; }
  .sc__title { font-size: clamp(48px, 6.2vw, 88px); line-height: 0.88; }
  .sc__meter { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; flex-shrink: 0; }
  .sc__meter .cr-label { font-size: 13px; color: var(--cr-bone-dim); }
  .sc__blink { width: 8px; height: 8px; border-radius: 50%; background: var(--cr-signal); animation: sc-blink 1.1s steps(1, end) infinite; }
  .sc__pct { font-family: var(--cr-display); font-weight: 900; font-size: clamp(52px, 5vw, 72px); line-height: 0.85; color: var(--cr-signal); }
  .sc__pct small { font-size: 0.45em; }

  /* ---------- Circuito (escritorio) ---------- */
  .sc__board { position: relative; height: 250px; }
  .sc__nodes { list-style: none; margin: 0; padding: 0; }
  .sc__item { position: absolute; left: var(--x); top: var(--y); width: var(--w); }
  .sc__trace { position: absolute; background-color: rgba(237, 232, 224, 0.22); }
  .sc__trace--h { background-image: repeating-linear-gradient(90deg, rgba(237, 232, 224, 0.35) 0 4px, transparent 4px 20px); animation: sc-current 2.4s linear infinite; }
  .sc__trace--v { background-image: repeating-linear-gradient(180deg, rgba(237, 232, 224, 0.35) 0 4px, transparent 4px 20px); animation: sc-current-v 2.4s linear infinite; }
  .sc__trace[data-lit] { background-color: var(--cr-signal); box-shadow: 0 0 14px var(--cr-signal); animation-duration: 0.9s; }
  .sc__trace--h[data-lit] { background-image: repeating-linear-gradient(90deg, rgba(17, 16, 18, 0.55) 0 6px, transparent 6px 20px); }
  .sc__trace--v[data-lit] { background-image: repeating-linear-gradient(180deg, rgba(17, 16, 18, 0.55) 0 6px, transparent 6px 20px); }
  .sc__link { display: none; }

  .sc__node {
    appearance: none; position: relative; width: 100%; height: 88px; margin: 0; padding: 0 16px; box-sizing: border-box;
    display: flex; align-items: center; gap: 14px; cursor: pointer; text-align: left; font: inherit;
    border: 2px solid rgba(237, 232, 224, 0.35); background-color: #19181b; color: var(--cr-bone);
    --pin: rgba(237, 232, 224, 0.35); --ring: rgba(237, 232, 224, 0.3);
    transition: transform 0.25s, background-color 0.3s, border-color 0.3s, color 0.3s;
  }
  .sc__node:hover { transform: translateY(-4px); }
  .sc__node:focus-visible { outline: 2px solid var(--cr-bone); outline-offset: 4px; }
  .sc__node[data-state="done"] { border-color: var(--cr-signal); background-color: rgba(237, 232, 224, 0.06); --pin: var(--cr-signal); --ring: var(--cr-signal); }
  .sc__node[data-state="here"] { border-color: var(--cr-signal); background-color: var(--cr-signal); color: var(--cr-ink); --pin: var(--cr-signal); --ring: rgba(17, 16, 18, 0.5); }
  .sc__icon { width: 44px; height: 44px; flex-shrink: 0; box-sizing: border-box; display: flex; align-items: center; justify-content: center; border: 1.5px solid var(--ring); }
  .sc__node-title { font-family: var(--cr-display); font-weight: 800; font-size: clamp(18px, 1.7vw, 24px); line-height: 1; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  /* Las etiquetas largas pasan a otra línea en vez de cortarse con "…" */
  .sc__node-tag { font-family: var(--cr-mono); font-size: 12px; line-height: 1.25; letter-spacing: 0.04em; opacity: 0.8; overflow: hidden; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; }
  .sc__pin { position: absolute; width: 8px; height: 8px; background-color: var(--pin); }
  .sc__pin--tl { left: 12px; top: -8px; } .sc__pin--tr { right: 12px; top: -8px; }
  .sc__pin--bl { left: 12px; bottom: -8px; } .sc__pin--br { right: 12px; bottom: -8px; }
  .sc__pulse { display: none; position: absolute; inset: -2px; border: 2px solid var(--cr-signal); pointer-events: none; animation: sc-pulse 1.6s cubic-bezier(0.2, 0.6, 0.3, 1) infinite; }
  .sc__node[data-state="here"] .sc__pulse { display: block; }

  /* ---------- Detalle ---------- */
  .sc__detail { display: grid; grid-template-columns: minmax(0, 1fr) 200px; gap: 40px; padding-top: 28px; border-top: 1px solid var(--cr-line-strong); }
  .sc__panel { display: grid; grid-template-columns: minmax(0, 1fr) 420px; gap: 40px; align-items: stretch; }
  .sc__panel[hidden] { display: none; }
  .sc__cur-title { display: flex; align-items: center; gap: 16px; font-size: clamp(34px, 3.2vw, 44px); line-height: 0.95; }
  .sc__cur-icon { width: 52px; height: 52px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; background-color: var(--cr-signal); color: var(--cr-ink); }
  .sc__why { padding: 18px 20px; border-left: 3px solid var(--cr-signal); background-color: rgba(237, 232, 224, 0.05); display: flex; flex-direction: column; gap: 8px; }
  .sc__rise { animation: sc-rise 0.45s cubic-bezier(0.16, 0.84, 0.24, 1) both; }
  .sc__nav { display: flex; flex-direction: column; gap: 8px; }
  .sc__btn {
    appearance: none; margin: 0; flex-grow: 1; min-height: 48px; cursor: pointer; border: 1px solid var(--cr-line-strong); background: transparent;
    color: var(--cr-bone); font-family: var(--cr-mono); font-size: 14px; letter-spacing: 0.12em; text-transform: uppercase;
    transition: border-color 0.2s;
  }
  .sc__btn--dim { color: rgba(237, 232, 224, 0.8); }
  .sc__btn:hover, .sc__btn:focus-visible { border-color: var(--cr-bone); }

  /* ---------- Tablet / móvil: circuito vertical ---------- */
  @media (min-width: 1200px) and (max-width: 1439px) {
    .sc__node { padding: 0 12px; gap: 10px; }
    .sc__icon { width: 36px; height: 36px; }
  }
  @media (max-width: 1199px) {
    .sc__board { height: auto; }
    .sc__trace { display: none; }
    .sc__nodes { display: flex; flex-direction: column; }
    .sc__item { position: static; width: auto; display: flex; flex-direction: column; }
    .sc__node:hover { transform: none; }
    .sc__pulse { animation-name: sc-pulse-sm; }
    .sc__node-title { font-size: 24px; }
    .sc__link {
      display: block; align-self: flex-start; margin-left: 37px; width: 6px; height: 32px;
      background-color: rgba(237, 232, 224, 0.22);
      background-image: repeating-linear-gradient(180deg, rgba(237, 232, 224, 0.35) 0 4px, transparent 4px 20px);
      animation: sc-current-v 2.4s linear infinite;
    }
    .sc__link[data-lit] {
      background-color: var(--cr-signal); box-shadow: 0 0 14px var(--cr-signal); animation-duration: 0.9s;
      background-image: repeating-linear-gradient(180deg, rgba(17, 16, 18, 0.55) 0 6px, transparent 6px 20px);
    }
    .sc__detail { grid-template-columns: minmax(0, 1fr); }
    .sc__panel { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .sc__nav { flex-direction: row-reverse; }
  }
  @media (max-width: 640px) {
    .sc__head { flex-direction: column; align-items: flex-start; gap: 24px; }
    .sc__meter { align-items: flex-start; }
    .sc__cur-title { font-size: 32px; }
  }

  @keyframes sc-pulse { 0% { transform: scale(0.8); opacity: 0.9; } 100% { transform: scale(1.6); opacity: 0; } }
  @keyframes sc-pulse-sm { 0% { transform: scale(0.98); opacity: 0.9; } 100% { transform: scale(1.03, 1.25); opacity: 0; } }
  @keyframes sc-current { to { background-position: 40px 0; } }
  @keyframes sc-current-v { to { background-position: 0 40px; } }
  @keyframes sc-rise { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
  @keyframes sc-blink { 0%, 55% { opacity: 1; } 56%, 100% { opacity: 0.25; } }
  @media (prefers-reduced-motion: reduce) {
    .sc *, .sc *::before, .sc *::after { animation: none !important; transition: none !important; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll<HTMLElement>("[data-circuit]").forEach((root) => {
    const nodes = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-node]"));
    const panels = Array.from(root.querySelectorAll<HTMLElement>("[data-panel]"));
    const segs = Array.from(root.querySelectorAll<HTMLElement>("[data-seg]"));
    const pctEl = root.querySelector<HTMLElement>("[data-circuit-pct]");
    const total = nodes.length;
    const stepMs = Number(root.dataset.stepMs) || 2200;
    let step = 0;
    let timer: number | undefined;
    let resume: number | undefined;
    let visible = false;

    const render = () => {
      nodes.forEach((n, i) => {
        n.dataset.state = i < step ? "done" : i === step ? "here" : "todo";
        n.setAttribute("aria-pressed", String(i === step));
      });
      panels.forEach((p, i) => (p.hidden = i !== step));
      segs.forEach((s) => s.toggleAttribute("data-lit", Number(s.dataset.seg) < step));
      if (pctEl) pctEl.textContent = String(Math.round(((step + 1) / total) * 100));
    };

    const halt = () => {
      window.clearInterval(timer);
      window.clearTimeout(resume);
      timer = resume = undefined;
    };
    const auto = () => {
      halt();
      if (reduce || !visible) return;
      timer = window.setInterval(() => {
        step = (step + 1) % total;
        render();
      }, stepMs);
    };
    const manual = (i: number) => {
      halt();
      step = (i + total) % total;
      render();
      resume = window.setTimeout(auto, 10000);
    };

    nodes.forEach((n, i) => n.addEventListener("click", () => manual(i)));
    root.querySelector("[data-circuit-next]")?.addEventListener("click", () => manual(step + 1));
    root.querySelector("[data-circuit-prev]")?.addEventListener("click", () => manual(step - 1));

    // Solo corre mientras la sección está en pantalla
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) { if (!resume) auto(); } else halt();
    }, { threshold: 0.25 }).observe(root);

    render();
  });
</script>
