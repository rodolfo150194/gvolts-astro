---
import FormField from "@/components/ui/FormField.astro";
import { Image } from "astro:assets";
import { avatars, type AvatarKey } from "@/data/avatar";
import { i18n } from "@/i18n";

const { tr, href } = i18n(Astro);
const t = tr.contactPanel;

// Técnico que "atiende" el formulario: cambia de casco según el sistema elegido
const techs: { key: AvatarKey; service: string; label: string; line: string }[] = (
  [
    { key: "point", service: "" },
    { key: "fire", service: "fire-alarm" },
    { key: "security", service: "security" },
    { key: "elec", service: "electricity" },
    { key: "general", service: "other" },
  ] as const
).map((x, i) => ({ ...x, ...t.techs[i] }));

const services = [
  { id: "fire-alarm", color: "var(--cr-signal)" },
  { id: "security", color: "#4da8ff" },
  { id: "electricity", color: "var(--cr-amber)" },
  { id: "other", color: "var(--cr-bone)" },
].map((x, i) => ({ ...x, ...t.services[i] }));
---

<div class="ctp-shell w-full">
<div class="tech" data-tech data-reveal style="--tech-color:var(--cr-bone);--d:120ms">
  <div class="tech__screen" aria-hidden="true">
    {
      techs.map((t, i) => (
        <Image
          src={avatars[t.key].src}
          alt=""
          widths={[280, 420, 640]}
          sizes="(min-width: 960px) 360px, 55vw"
          class="tech__img"
          data-tech-img={t.key}
          data-on={i === 0 ? "" : undefined}
          loading={i === 0 ? "eager" : "lazy"}
        />
      ))
    }
    <span class="tech__scan"></span>
  </div>
  <div class="tech__bubble" aria-live="polite">
    <p class="tech__label"><span class="tech__led"></span><span data-tech-label>{techs[0].label}</span></p>
    <p class="tech__line" data-tech-line>{techs[0].line}</p>
  </div>
  <script type="application/json" data-tech-data set:html={JSON.stringify(techs)} />
</div>

<div class="ctp w-full bg-[var(--cr-ink-2)] border border-[var(--cr-line-strong)] shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)]" data-reveal style="--d:200ms">
  <div class="flex justify-between items-center px-7 py-[18px] border-b border-[var(--cr-line)] [font-family:var(--cr-mono)] text-sm tracking-[0.14em] uppercase max-[480px]:flex-wrap max-[480px]:gap-2 max-[480px]:px-[18px] max-[480px]:py-[14px]">
    <span class="text-[var(--cr-bone-dim)] max-[400px]:text-[12px]">{t.header}</span>
    <span class="flex items-center gap-2 text-[var(--cr-signal)] data-[sent]:text-[var(--cr-ok)]" data-status>
      <span class="cr-led cr-blink" data-status-led></span>
      <span data-status-text aria-live="polite">{t.statusOpen}</span>
    </span>
  </div>

  <form class="flex flex-col gap-6 py-8 px-7 max-[480px]:gap-5 max-[480px]:py-6 max-[480px]:px-[18px]" id="contact-form" data-form data-i18n={JSON.stringify(t.script)}>
    <fieldset class="m-0 p-0 border-0 flex flex-col gap-3">
      <legend class="cr-label mb-1">{t.legend}</legend>
      <div class="grid grid-cols-4 gap-2 max-sm:grid-cols-2 max-[400px]:grid-cols-1" role="radiogroup" aria-label={t.radioAria}>
        {
          services.map((s, i) => (
            <button
              type="button"
              class="group appearance-none cursor-pointer h-14 flex items-center justify-center gap-2 border border-[var(--cr-line-strong)] bg-transparent text-[var(--cr-bone)] [font-family:var(--cr-body)] text-[16px] font-semibold transition-[background-color,color,border-color] duration-200 aria-checked:bg-[var(--chip-color)] aria-checked:border-[var(--chip-color)] aria-checked:text-[var(--cr-ink)] max-[480px]:h-auto max-[480px]:min-h-[52px] max-[480px]:px-1 max-[480px]:py-2 max-[480px]:text-[14px] max-[480px]:text-center"
              data-chip
              data-service={s.id}
              data-placeholder={s.placeholder}
              role="radio"
              aria-checked={i === 0 ? "true" : "false"}
              style={`--chip-color:${s.color}`}
            >
              <span class="w-2 h-2 shrink-0 bg-[var(--chip-color)] group-aria-checked:bg-[var(--cr-ink)]" />
              {s.label}
            </button>
          ))
        }
      </div>
    </fieldset>

    <div class="grid grid-cols-2 gap-4 max-sm:grid-cols-1">
      <FormField label={t.fields.name} type="text" name="name" autocomplete="name" required minlength="2" placeholder={t.fields.namePlaceholder} />
      <FormField label={t.fields.phone} type="tel" name="phone" autocomplete="tel" required minlength="10" placeholder="+1 (555) 000-0000" />
    </div>

    <div class="grid grid-cols-2 gap-4 max-sm:grid-cols-1">
      <FormField label={t.fields.email} type="email" name="email" autocomplete="email" required placeholder={t.fields.emailPlaceholder} />
      <FormField label={t.fields.zip} type="text" name="zip" autocomplete="postal-code" required minlength="5" maxlength="10" placeholder="12345" />
    </div>

    <FormField label={t.fields.message} as="textarea" name="message" rows="5" required minlength="10" placeholder={services[0].placeholder} data-message />

    <label class="flex items-start gap-3 text-[15px] leading-normal text-[var(--cr-bone-dim)] font-normal">
      <input class="mt-0.5 w-5 h-5 shrink-0 accent-[var(--cr-signal)]" type="checkbox" name="privacy" required />
      <span>
        {t.privacy1} <a href={href("/privacy")} target="_blank" class="text-[var(--cr-bone)] underline underline-offset-4 hover:text-[var(--cr-signal)]">{t.privacyLink}</a>
        {t.privacy2}
      </span>
    </label>

    <button class="cr-btn group justify-center h-16 [font-family:var(--cr-display)] font-extrabold text-2xl disabled:opacity-60 disabled:cursor-not-allowed max-[480px]:text-[19px] max-[480px]:h-14" type="submit">
      <span aria-live="polite">
        <span data-submit-text>{t.submit}</span>
        <span class="ctp__submit-loading" data-submit-loading hidden>{t.sending}</span>
      </span>
      <span class="inline-block transition-transform duration-300 group-hover:translate-x-[6px]" aria-hidden="true">→</span>
    </button>

    <p class="[font-family:var(--cr-mono)] text-[13px] tracking-[0.1em] text-center text-[var(--cr-bone-dim)]">{t.note}</p>

    <p class="m-0 py-3.5 px-4 bg-[color-mix(in_srgb,var(--cr-signal)_14%,transparent)] border border-[var(--cr-signal)] text-[var(--cr-bone)] text-[15px]" data-error hidden aria-live="assertive"></p>
  </form>

  <div class="flex flex-col items-start gap-6 py-16 px-10 max-[480px]:py-12 max-[480px]:px-6" data-success hidden tabindex="-1" aria-live="polite">
    <span class="w-16 h-16 flex items-center justify-center bg-[var(--cr-ok)]">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="#111012" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>
    </span>
    <h2 class="text-[clamp(48px,6vw,72px)] leading-[0.9]">{t.successTitle1}<br />{t.successTitle2}</h2>
    <p class="text-lg leading-[1.6] text-[var(--cr-bone-dim)]">{t.successText1} <strong data-success-service>{t.script.labels.other}</strong> {t.successText2}</p>
    <button type="button" class="cr-btn cr-btn--ghost" data-again>{t.again}</button>
  </div>
</div>
</div>

<style>
  .tech { display: flex; align-items: flex-end; gap: clamp(12px, 2vw, 24px); }
  .tech__screen {
    position: relative; flex-shrink: 0; width: clamp(200px, 24vw, 340px); aspect-ratio: 1 / 0.6; overflow: hidden;
    border-bottom: 2px solid var(--tech-color); transition: border-color 0.4s;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent);
  }
  .tech__img { position: absolute; left: 0; top: 0; width: 100%; height: auto; opacity: 0; transition: opacity 0.25s; }
  .tech__img[data-on] { opacity: 1; }
  /* "Cambio de canal": la imagen nueva se enciende como un monitor CRT */
  .tech[data-switching] .tech__img[data-on] { animation: tech-on 0.5s cubic-bezier(0.2, 0.8, 0.2, 1) both; }
  .tech__scan {
    position: absolute; inset: 0; pointer-events: none; opacity: 0;
    background: repeating-linear-gradient(180deg, rgba(237, 232, 224, 0.12) 0 2px, transparent 2px 5px);
  }
  .tech[data-switching] .tech__scan { animation: tech-scan 0.5s linear both; }
  .tech__bubble {
    position: relative; flex: 1; min-width: 0; margin-bottom: 18px; padding: 14px 18px;
    background: var(--cr-ink-2); border: 1px solid var(--cr-line-strong); border-left: 3px solid var(--tech-color);
    transition: border-color 0.4s;
  }
  .tech__bubble::before {
    content: ""; position: absolute; left: -11px; bottom: 16px; width: 0; height: 0;
    border: 8px solid transparent; border-right-color: var(--tech-color); border-left: 0;
  }
  .tech__label { display: flex; align-items: center; gap: 8px; font-family: var(--cr-mono); font-size: 13px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--tech-color); }
  .tech__led { width: 7px; height: 7px; border-radius: 50%; background: var(--tech-color); box-shadow: 0 0 10px var(--tech-color); }
  .tech__line { margin-top: 6px; font-size: 16px; line-height: 1.5; color: var(--cr-bone); }
  .tech[data-switching] .tech__line { animation: tech-type 0.45s ease-out both; }
  @media (max-width: 480px) {
    .tech__screen { width: 46vw; }
    .tech__bubble { padding: 10px 12px; margin-bottom: 10px; }
    .tech__line { font-size: 15px; }
  }
  @keyframes tech-on {
    0% { clip-path: inset(49% 0 49% 0); filter: brightness(3) saturate(0); }
    45% { clip-path: inset(0 0 0 0); filter: brightness(1.8) saturate(0.4); }
    100% { clip-path: inset(0 0 0 0); filter: none; }
  }
  @keyframes tech-scan { 0% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes tech-type { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) {
    .tech[data-switching] .tech__img[data-on], .tech[data-switching] .tech__scan, .tech[data-switching] .tech__line { animation: none; }
  }
</style>

<script>
  import { actions } from "astro:actions";
  import type { Dictionary } from "@/i18n";
  import { fmt, readStrings } from "@/i18n/format";

  const panel = document.querySelector<HTMLElement>(".ctp");
  if (panel) {
    const form = panel.querySelector<HTMLFormElement>("[data-form]")!;
    const chips = panel.querySelectorAll<HTMLButtonElement>("[data-chip]");
    const message = panel.querySelector<HTMLTextAreaElement>("[data-message]")!;
    const statusEl = panel.querySelector<HTMLElement>("[data-status]")!;
    const statusText = panel.querySelector<HTMLElement>("[data-status-text]")!;
    const statusLed = panel.querySelector<HTMLElement>("[data-status-led]")!;
    const submitText = panel.querySelector<HTMLElement>("[data-submit-text]")!;
    const submitLoading = panel.querySelector<HTMLElement>("[data-submit-loading]")!;
    const submitButton = panel.querySelector<HTMLButtonElement>(".ctp__submit")!;
    const errorEl = panel.querySelector<HTMLElement>("[data-error]")!;
    const successEl = panel.querySelector<HTMLElement>("[data-success]")!;
    const successService = panel.querySelector<HTMLElement>("[data-success-service]")!;
    const againButton = panel.querySelector<HTMLButtonElement>("[data-again]")!;

    // Textos traducidos (src/i18n → contactPanel.script)
    const S = readStrings<Dictionary["contactPanel"]["script"]>(form);
    const labels: Record<string, string> = S.labels;

    let selected = chips[0]?.dataset.service ?? "fire-alarm";

    // Técnico: cambia de variante según el sistema elegido
    const tech = document.querySelector<HTMLElement>("[data-tech]");
    const techData: { key: string; service: string; label: string; line: string }[] = JSON.parse(
      tech?.querySelector("[data-tech-data]")?.textContent ?? "[]",
    );
    const techColors: Record<string, string> = {};
    chips.forEach((c) => (techColors[c.dataset.service ?? ""] = c.style.getPropertyValue("--chip-color")));
    const showTech = (service: string, line?: string) => {
      if (!tech) return;
      const t = techData.find((d) => d.service === service) ?? techData[0];
      const current = tech.querySelector<HTMLElement>("[data-tech-img][data-on]");
      const next = tech.querySelector<HTMLElement>(`[data-tech-img="${t.key}"]`);
      tech.querySelector("[data-tech-label]")!.textContent = t.label;
      tech.querySelector("[data-tech-line]")!.textContent = line ?? t.line;
      tech.style.setProperty("--tech-color", techColors[service] || "var(--cr-bone)");
      if (next && next !== current) {
        current?.removeAttribute("data-on");
        next.setAttribute("data-on", "");
      }
      tech.removeAttribute("data-switching");
      void tech.offsetWidth; // reinicia la animación
      tech.setAttribute("data-switching", "");
    };

    const selectChip = (chip: HTMLButtonElement) => {
      selected = chip.dataset.service ?? "fire-alarm";
      chips.forEach((c) => {
        c.setAttribute("aria-checked", c === chip ? "true" : "false");
        c.tabIndex = c === chip ? 0 : -1;
      });
      message.placeholder = chip.dataset.placeholder ?? "";
      showTech(selected);
    };

    chips.forEach((chip, i) => {
      chip.tabIndex = i === 0 ? 0 : -1;
      chip.addEventListener("click", () => selectChip(chip));
      chip.addEventListener("keydown", (e) => {
        const arrows = ["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp"];
        if (!arrows.includes(e.key)) return;
        e.preventDefault();
        const dir = e.key === "ArrowRight" || e.key === "ArrowDown" ? 1 : -1;
        const next = chips[(i + dir + chips.length) % chips.length];
        selectChip(next);
        next.focus();
      });
    });

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      submitButton.disabled = true;
      submitText.hidden = true;
      submitLoading.hidden = false;

      const formData = new FormData(form);
      const serviceLabel = labels[selected] ?? labels.other;

      try {
        const { error } = await actions.contact({
          name: formData.get("name") as string,
          email: formData.get("email") as string,
          phone: formData.get("phone") as string,
          zip: formData.get("zip") as string,
          service: selected as "fire-alarm" | "security" | "electricity" | "other",
          subject: fmt(S.subject, { service: serviceLabel }),
          message: formData.get("message") as string,
        });

        if (error) {
          errorEl.textContent = error.message || S.validation;
          errorEl.hidden = false;
          return;
        }

        form.hidden = true;
        successEl.hidden = false;
        successService.textContent = serviceLabel;
        showTech(selected, S.received);
        statusText.textContent = S.statusReceived;
        statusEl.setAttribute("data-sent", "");
        statusLed.classList.remove("cr-led--signal");
        successEl.focus();
      } catch {
        errorEl.textContent = S.error;
        errorEl.hidden = false;
      } finally {
        submitButton.disabled = false;
        submitText.hidden = false;
        submitLoading.hidden = true;
      }
    });

    againButton.addEventListener("click", () => {
      form.reset();
      form.hidden = false;
      successEl.hidden = true;
      statusText.textContent = S.statusOpen;
      statusEl.removeAttribute("data-sent");
      chips.forEach((c, i) => {
        c.setAttribute("aria-checked", i === 0 ? "true" : "false");
        c.tabIndex = i === 0 ? 0 : -1;
      });
      selected = chips[0]?.dataset.service ?? "fire-alarm";
      message.placeholder = chips[0]?.dataset.placeholder ?? "";
      showTech("");
    });
  }
</script>
