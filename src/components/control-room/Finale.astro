---
import type { ImageMetadata } from "astro";
import { ArrowUp } from "@lucide/astro";
import { Image } from "astro:assets";
import { socials } from "@/data/socials";
import { avatars, type AvatarKey } from "@/data/avatar";

interface Props {
  logo?: ImageMetadata;
  /** Variante del técnico que se asoma en el cierre (casco y herramienta del servicio). */
  avatar?: AvatarKey;
}

const { logo, avatar = "general" } = Astro.props;
const tech = avatars[avatar];
const year = new Date().getFullYear();

const footerServices = [
  { label: "Alarmas de incendio", href: "/services/fire-alarm" },
  { label: "Seguridad", href: "/services/security" },
  { label: "Electricidad", href: "/services/electricity" },
];

const footerCompany = [
  { label: "Proyectos", href: "/projects" },
  { label: "Nosotros", href: "/about" },
  { label: "Contacto", href: "/contact" },
];
---

<section class="fin bg-[var(--cr-signal-deep)] text-[var(--cr-ink)] py-[clamp(96px,12vw,170px)] [clip-path:polygon(0_48px,48px_0,100%_0,100%_100%,0_100%)]">
  <div class="cr-wrap relative">
    <div class="fin__content">
    <p class="cr-label !text-[var(--cr-ink)]" data-reveal>04 — Siguiente paso</p>
    <h2 class="mt-[18px] text-[length:clamp(60px,11vw,176px)] min-[900px]:text-[length:clamp(60px,8.4vw,140px)] max-[720px]:text-[length:clamp(38px,13vw,60px)]" data-reveal style="--d:80ms">¿Tu inmueble<br />está protegido?</h2>
    <div class="flex flex-wrap justify-between items-end gap-[32px] mt-[48px] max-[720px]:items-start max-[520px]:flex-col max-[520px]:items-stretch" data-reveal style="--d:160ms">
      <p class="max-w-[42ch] text-[19px]">Agenda una visita técnica sin costo. Te entregamos un diagnóstico y un presupuesto cerrado en 24 horas.</p>
      <a href="/contact" class="group inline-flex items-center gap-[28px] pt-[20px] pr-[20px] pb-[20px] pl-[32px] bg-[var(--cr-ink)] !text-[var(--cr-bone)] [font-family:var(--cr-mono)] text-[14px] font-semibold tracking-[0.14em] uppercase transition-[background] duration-300 max-[720px]:gap-[18px] max-[720px]:pt-[16px] max-[720px]:pr-[16px] max-[720px]:pb-[16px] max-[720px]:pl-[22px] max-[520px]:justify-between">
        <span>Agendar visita</span>
        <span class="grid place-items-center w-[48px] h-[48px] bg-[var(--cr-signal)] text-[var(--cr-ink)] text-[20px] transition-transform duration-[350ms] ease-[cubic-bezier(0.5,1.6,0.4,1)] group-hover:translate-x-[8px] group-hover:-rotate-45 max-[720px]:w-[40px] max-[720px]:h-[40px]" aria-hidden="true">→</span>
      </a>
    </div>
    </div>

    <!-- Técnico de guardia: sube desde el borde inferior al entrar en pantalla -->
    <div class="fin__av" data-reveal style="--d:240ms">
      <p class="fin__tag"><span class="fin__led" aria-hidden="true"></span>Técnico de guardia · en línea</p>
      <Image src={tech.src} alt={tech.alt} widths={[320, 480, 640, 960]} sizes="(min-width: 900px) min(34vw, 500px), 82vw" class="fin__img" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .fin__av {
    position: relative;
    width: min(82vw, 380px);
    margin: 72px 0 calc(-1 * clamp(96px, 12vw, 170px)) auto;
    pointer-events: none;
  }
  .fin__img { display: block; width: 100%; height: auto; filter: drop-shadow(0 24px 40px rgba(17, 16, 18, 0.35)); }
  .fin__tag {
    position: absolute; left: 16%; top: -40px; z-index: 1; display: flex; align-items: center; gap: 8px;
    padding: 8px 12px; background: var(--cr-ink); color: var(--cr-bone);
    font-family: var(--cr-mono); font-size: 11px; letter-spacing: 0.14em; text-transform: uppercase; white-space: nowrap;
  }
  .fin__led { width: 8px; height: 8px; border-radius: 50%; background: var(--cr-ok); box-shadow: 0 0 10px var(--cr-ok); animation: fin-blink 1.4s steps(1, end) infinite; }
  /* Entra "subiendo" desde el borde de la sección en lugar del reveal estándar */
  .fin__av[data-reveal]:not(.is-in) { transform: translateY(30%); }

  @media (min-width: 900px) {
    .fin__content { padding-right: calc(min(34vw, 500px) - 40px); }
    .fin__av { position: absolute; right: -24px; bottom: calc(-1 * clamp(96px, 12vw, 170px)); width: min(34vw, 500px); margin: 0; }
  }
  @keyframes fin-blink { 0%, 60% { opacity: 1; } 61%, 100% { opacity: 0.3; } }
  @media (prefers-reduced-motion: reduce) {
    .fin__av[data-reveal]:not(.is-in) { transform: none; }
    .fin__led { animation: none; }
  }
</style>

<footer class="pt-[clamp(72px,8vw,120px)] bg-[var(--cr-ink)]">
  <div class="cr-wrap">
    <div class="grid [grid-template-columns:minmax(0,1fr)_auto] items-start gap-[clamp(32px,4vw,72px)] max-[1100px]:[grid-template-columns:1fr]">
      <!-- Contenido: a la izquierda del logo y por encima -->
      <div class="min-w-0" data-reveal>
        <p class="cr-label mb-[25px]">Mantente informado</p>
        <h3 class="text-[length:clamp(30px,3.6vw,52px)] max-w-[22ch]">Señal directo tu correo</h3>

        <form class="mt-[24px] flex flex-col gap-[12px] max-w-[560px]" data-nl novalidate={false}>
          <label class="cr-label !text-[var(--cr-bone-dim)] !text-[11px]" for="nl-email">Correo electrónico</label>
          <div class="flex gap-[10px] max-[520px]:flex-col">
            <input
              id="nl-email"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="tu@empresa.com"
              class="box-border flex-1 min-w-0 h-[56px] px-[16px] bg-[var(--cr-ink-2)] border border-[var(--cr-line-strong)] text-[var(--cr-bone)] [font-family:var(--cr-body)] text-[16px] transition-[border-color] duration-200 hover:border-[color-mix(in_srgb,var(--cr-bone)_60%,transparent)] focus-visible:border-[var(--cr-signal)]"
            />
            <button type="submit" class="cr-btn group justify-center shrink-0 !h-[56px] !min-h-[56px] max-[520px]:w-full" data-nl-submit>
              <span data-nl-label>Suscribir</span>
              <span class="inline-block transition-transform duration-300 group-hover:translate-x-[6px]" aria-hidden="true">→</span>
            </button>
          </div>
          <p class="[font-family:var(--cr-mono)] text-[11px] leading-[1.7] tracking-[0.08em] uppercase text-[var(--cr-bone-dim)]">Un envío al mes. Normativas, mantenimiento y casos reales. Sin spam.</p>
          <p class="m-0 py-[12px] px-[14px] bg-[var(--cr-ink-2)] border border-[var(--cr-line-strong)] text-[var(--cr-bone)] text-[14px] data-[state=error]:border-[var(--cr-signal)] data-[state=error]:bg-[color-mix(in_srgb,var(--cr-signal)_14%,transparent)] data-[state=ok]:border-[var(--cr-ok)] data-[state=ok]:bg-[color-mix(in_srgb,var(--cr-ok)_14%,transparent)]" data-nl-msg hidden role="status"></p>
        </form>
      </div>

      <!-- Logo: extremo derecho, con redes sociales encima -->
      <div class="flex flex-col items-end gap-[28px] max-[1100px]:items-start">
        <div class="flex flex-col items-end gap-[14px] max-[1100px]:items-start">
          <p class="cr-label">Síguenos</p>
          <div class="flex flex-wrap gap-[10px]">
            {socials.map((social) => (
              <a
                href={social.url}
                aria-label={social.ariaLabel}
                target="_blank"
                rel="noopener noreferrer"
                class="grid place-items-center w-[46px] h-[46px] border border-[var(--cr-line-strong)] text-[var(--cr-bone-dim)] transition-[background,color,border-color,transform] duration-300 hover:bg-[var(--cr-signal)] hover:border-[var(--cr-signal)] hover:text-[var(--cr-ink)] hover:-translate-y-[2px] max-[520px]:w-[44px] max-[520px]:h-[44px]"
                set:html={social.icon}
              />
            ))}
          </div>
        </div>

        <a href="/" class="inline-flex items-end" aria-label="GVolts Corp, inicio">
          {logo ? (
            <img src={logo.src} alt="GVolts Corp" width={logo.width} height={logo.height} class="h-[clamp(64px,9vw,140px)] w-auto" />
          ) : (
            <span class="inline-flex items-stretch [font-family:var(--cr-display)] font-black text-[length:clamp(48px,7.5vw,120px)] leading-none tracking-[0.02em]">
              <span class="bg-[var(--cr-bone)] text-[var(--cr-ink)] [padding:0.2em_0.2em_0.13em_0.26em]">G</span><span class="bg-[var(--cr-signal-deep)] text-[var(--cr-ink)] [padding:0.2em_0.26em_0.13em_0.13em]">VOLTS</span>
              <span class="[writing-mode:vertical-rl] [font-family:var(--cr-mono)] text-[0.27em] font-bold tracking-[0.2em] bg-[var(--cr-ink-3)] text-[var(--cr-bone)] [padding:0.1em_0.13em] grid place-items-center">CORP</span>
            </span>
          )}
        </a>
      </div>
    </div>

    <!-- Enlaces: ancho completo -->
    <div class="w-full mt-[clamp(40px,5vw,64px)] pt-[clamp(36px,4vw,56px)] border-t border-[var(--cr-line)] grid [grid-template-columns:1.5fr_1fr_1fr] gap-[clamp(32px,4vw,56px)] max-[820px]:grid-cols-2 max-[520px]:grid-cols-1" data-reveal>
          <div>
            <p class="cr-label mb-[18px]">Contacto</p>
            <dl class="m-0">
              <div class="flex items-baseline gap-[16px] py-[13px] border-t border-[var(--cr-line)]">
                <dt class="cr-label w-[46px] shrink-0 !text-[10px]">Tel</dt>
                <dd class="m-0 [font-family:var(--cr-display)] font-bold text-[length:clamp(19px,1.9vw,26px)] leading-[1.15]">
                  <a href="tel:+15551234567" class="transition-colors duration-200 hover:!text-[var(--cr-signal)]">+1 (555) 123-4567</a>
                </dd>
              </div>
              <div class="flex items-baseline gap-[16px] py-[13px] border-t border-[var(--cr-line)]">
                <dt class="cr-label w-[46px] shrink-0 !text-[10px]">Mail</dt>
                <dd class="m-0 [font-family:var(--cr-display)] font-bold text-[length:clamp(19px,1.9vw,26px)] leading-[1.15]">
                  <a href="mailto:info@gvolts.com" class="transition-colors duration-200 hover:!text-[var(--cr-signal)]">info@gvolts.com</a>
                </dd>
              </div>
              <div class="flex items-start gap-[16px] py-[13px] border-t border-[var(--cr-line)]">
                <dt class="cr-label w-[46px] shrink-0 !text-[10px] mt-[3px]">Dir</dt>
                <dd class="m-0 text-[var(--cr-bone-dim)]">Av. Tecnológica 123<br />Ciudad Innovación, CP 12345</dd>
              </div>
              <div class="flex items-center gap-[16px] py-[13px] border-y border-[var(--cr-line)]">
                <dt class="sr-only">Estado</dt>
                <dd class="m-0 flex items-center gap-[10px] [font-family:var(--cr-mono)] text-[11px] tracking-[0.1em] uppercase text-[var(--cr-bone-dim)]"><span class="cr-led"></span>Central operativa 24/7/365</dd>
              </div>
            </dl>
          </div>

          <nav aria-label="Servicios">
            <p class="cr-label mb-[18px]">Servicios</p>
            <ul class="list-none m-0 p-0">
              {footerServices.map((s, i) => (
                <li class="border-t border-[var(--cr-line)]">
                  <a href={s.href} class="group flex items-center gap-[12px] py-[13px] text-[var(--cr-bone-dim)] transition-colors duration-200 hover:text-[var(--cr-signal)]">
                    <span class="[font-family:var(--cr-mono)] text-[10.5px] tracking-[0.1em] opacity-60 transition-opacity duration-200 group-hover:opacity-100" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <span>{s.label}</span>
                    <span class="ml-auto translate-x-[-6px] opacity-0 transition-[opacity,transform] duration-300 group-hover:translate-x-0 group-hover:opacity-100" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>

          <nav aria-label="Empresa">
            <p class="cr-label mb-[18px]">Empresa</p>
            <ul class="list-none m-0 p-0">
              {footerCompany.map((l, i) => (
                <li class="border-t border-[var(--cr-line)]">
                  <a href={l.href} class="group flex items-center gap-[12px] py-[13px] text-[var(--cr-bone-dim)] transition-colors duration-200 hover:text-[var(--cr-signal)]">
                    <span class="[font-family:var(--cr-mono)] text-[10.5px] tracking-[0.1em] opacity-60 transition-opacity duration-200 group-hover:opacity-100" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                    <span>{l.label}</span>
                    <span class="ml-auto translate-x-[-6px] opacity-0 transition-[opacity,transform] duration-300 group-hover:translate-x-0 group-hover:opacity-100" aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
    </div>

    <div class="cr-label flex justify-between flex-wrap gap-[12px] mt-[clamp(56px,8vw,100px)] pt-[24px] pb-[32px] border-t border-[var(--cr-line)] !text-[10.5px]">
      <span>© {year} GVolts Corp</span>
      <span>Electrical · Fire · Security</span>
      <span>UL · NFPA · NEC · NICET</span>
    </div>
  </div>

  <button
    type="button"
    class="fixed bottom-[24px] right-[88px] z-[90] grid place-items-center w-[52px] h-[52px] p-0 bg-[var(--cr-signal)] text-[var(--cr-ink)] border border-[var(--cr-signal)] cursor-pointer [clip-path:polygon(0_0,calc(100%-14px)_0,100%_14px,100%_100%,14px_100%,0_calc(100%-14px))] opacity-0 invisible translate-y-[12px] transition-[opacity,transform,background,border-color] duration-[350ms] ease-[cubic-bezier(0.2,0.7,0.1,1)] hover:bg-[var(--cr-bone)] hover:border-[var(--cr-bone)] [&.is-visible]:opacity-100 [&.is-visible]:visible [&.is-visible]:translate-y-0 [&_svg]:w-[22px] [&_svg]:h-[22px] md:bottom-[28px] md:right-[100px]"
    aria-label="Volver arriba"
    data-cr-top
  >
    <ArrowUp stroke-width={2.5} />
  </button>
</footer>

<script>
  import { actions } from "astro:actions";

  const form = document.querySelector<HTMLFormElement>("[data-nl]");
  if (form) {
    const input = form.querySelector<HTMLInputElement>("[name=email]")!;
    const button = form.querySelector<HTMLButtonElement>("[data-nl-submit]")!;
    const label = form.querySelector<HTMLElement>("[data-nl-label]")!;
    const msg = form.querySelector<HTMLElement>("[data-nl-msg]")!;

    const show = (text: string, state: "ok" | "error") => {
      msg.textContent = text;
      msg.dataset.state = state;
      msg.hidden = false;
    };

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      msg.hidden = true;
      button.disabled = true;
      label.textContent = "Enviando…";

      try {
        const { error } = await actions.newsletter({ email: input.value.trim() });

        if (error) {
          show(error.message || "Correo electrónico inválido.", "error");
          return;
        }

        form.reset();
        show("Listo. Te agregamos a la lista de contactos.", "ok");
      } catch {
        show("No pudimos suscribirte. Intenta nuevamente.", "error");
      } finally {
        button.disabled = false;
        label.textContent = "Suscribir";
      }
    });
  }

  const topButton = document.querySelector<HTMLButtonElement>("[data-cr-top]");
  if (topButton) {
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let visible = false;

    const sync = () => {
      const shouldShow = window.scrollY > 400;
      if (shouldShow === visible) return;
      visible = shouldShow;
      topButton.classList.toggle("is-visible", shouldShow);
      topButton.setAttribute("aria-hidden", String(!shouldShow));
      topButton.tabIndex = shouldShow ? 0 : -1;
    };

    window.addEventListener("scroll", sync, { passive: true });
    sync();

    topButton.addEventListener("click", () => {
      window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
    });
  }
</script>
