---
interface Circuit {
  id: string;
  name: string;
  amps: number;
  on: boolean;
}

const circuits: Circuit[] = [
  { id: "C1", name: "Cocina", amps: 20, on: true },
  { id: "C2", name: "Aire acondicionado", amps: 30, on: true },
  { id: "C3", name: "Cargador EV", amps: 40, on: false },
  { id: "C4", name: "Iluminación LED", amps: 15, on: true },
  { id: "C5", name: "Lavandería", amps: 30, on: true },
  { id: "C6", name: "Oficina en casa", amps: 20, on: true },
  { id: "C7", name: "Calentador de agua", amps: 30, on: true },
  { id: "C8", name: "Tomas exteriores", amps: 15, on: false },
];

const MAX_AMPS = 200;
const load = circuits.filter((c) => c.on).reduce((sum, c) => sum + c.amps, 0);
const pct = Math.round((load / MAX_AMPS) * 100);
---

<div
  class="breaker-panel bg-[var(--cr-ink-2)] border border-[var(--cr-line-strong)] shadow-[0_40px_80px_-30px_rgba(0,0,0,0.9)]"
  data-breaker-panel
  data-max={MAX_AMPS}
>
  <div
    class="flex justify-between items-center px-[20px] py-[16px] border-b border-[var(--cr-line)] font-[var(--cr-mono)] text-[12px] tracking-[0.14em] uppercase text-[var(--cr-bone-dim)] max-[480px]:flex-wrap max-[480px]:gap-[8px] max-[480px]:px-[16px] max-[480px]:py-[12px]"
  >
    <span>Tablero principal · 240 V</span>
    <span class="flex items-center gap-[8px]" data-bp-status>
      <span
        class="w-[8px] h-[8px] rounded-full animate-[bp-hum_2.4s_ease-in-out_infinite] motion-reduce:animate-none"
        data-bp-status-dot
      ></span>
      <span data-bp-status-label>Carga estable</span>
    </span>
  </div>

  <div class="px-[20px] pt-[24px] pb-[20px] flex flex-col gap-[14px] border-b border-[var(--cr-line)]">
    <div class="flex justify-between items-end">
      <p class="font-[var(--cr-display)] font-black text-[clamp(56px,6vw,88px)] leading-[0.9]">
        <span data-bp-load>{load}</span><span class="text-[clamp(24px,2.6vw,40px)] text-[var(--cr-bone-dim)]"> / {MAX_AMPS} A</span>
      </p>
      <p class="font-[var(--cr-mono)] text-[13px]" data-bp-pct><span data-bp-pct-value>{pct}</span>% CARGA</p>
    </div>
    <div class="h-[10px] bg-[var(--cr-ink-3)]">
      <div class="h-[10px] transition-[width,background-color] duration-500 [transition-timing-function:cubic-bezier(0.16,0.84,0.24,1)]" data-bp-bar style={`width:${pct}%`}></div>
    </div>
  </div>

  <div class="p-[16px] grid grid-cols-2 gap-[10px] max-[480px]:grid-cols-1">
    {
      circuits.map((c) => (
        <button
          type="button"
          class="breaker group appearance-none m-0 h-[72px] flex items-center gap-[14px] px-[14px] bg-[var(--cr-ink)] border border-[var(--cr-line)] text-[var(--cr-bone)] text-left cursor-pointer transition-colors duration-200 hover:border-[var(--cr-signal)] max-[480px]:h-auto max-[480px]:min-h-[60px] max-[480px]:px-[14px] max-[480px]:py-[10px]"
          data-bp-breaker
          data-id={c.id}
          data-amps={c.amps}
          aria-pressed={c.on ? "true" : "false"}
          aria-label={`${c.name} ${c.on ? "encendido" : "apagado"}`}
        >
          <span class="relative shrink-0 w-[26px] h-[48px] bg-[var(--cr-ink-3)] border border-[var(--cr-line-strong)]">
            <span
              class="absolute left-[2px] top-[24px] w-[20px] h-[20px] bg-[#6b6770] transition-[top,background-color] duration-[250ms] [transition-timing-function:cubic-bezier(0.3,1.4,0.5,1)] group-aria-pressed:top-[2px] group-aria-pressed:bg-[var(--cr-signal)]"
              data-bp-knob
            />
          </span>
          <span class="grow flex flex-col gap-[4px] min-w-0">
            <span class="breaker__name text-[15px] font-semibold max-[480px]:text-[14px]">{c.name}</span>
            <span class="font-[var(--cr-mono)] text-[11px] tracking-[0.08em] text-[var(--cr-bone-dim)]">
              {c.id} · {c.amps} A
            </span>
          </span>
          <span
            class="w-[8px] h-[8px] rounded-full bg-[#3a373d] shrink-0 transition-[background-color,box-shadow] duration-200 group-aria-pressed:bg-[var(--cr-ok)] group-aria-pressed:shadow-[0_0_10px_var(--cr-ok)]"
            data-bp-led
          />
        </button>
      ))
    }
  </div>

  <p class="px-[20px] pb-[18px] text-[14px] text-[var(--cr-bone-dim)]">Activa o corta circuitos y mira la carga del tablero en tiempo real.</p>
</div>

<style>
  @keyframes bp-hum {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
</style>

<script>
  const LOAD_OK = "#7ee2a8";
  const LOAD_HIGH = "#ffd66b";
  const LOAD_OVER = "#e0605a";

  const root = document.querySelector<HTMLElement>("[data-breaker-panel]");
  if (!root) throw new Error("BreakerPanel root not found");

  const max = Number(root.dataset.max ?? 200);
  const breakers = [...root.querySelectorAll<HTMLButtonElement>("[data-bp-breaker]")];
  const loadEl = root.querySelector<HTMLElement>("[data-bp-load]");
  const pctEl = root.querySelector<HTMLElement>("[data-bp-pct-value]");
  const barEl = root.querySelector<HTMLElement>("[data-bp-bar]");
  const statusDot = root.querySelector<HTMLElement>("[data-bp-status-dot]");
  const statusLabel = root.querySelector<HTMLElement>("[data-bp-status-label]");

  const recalc = () => {
    const load = breakers
      .filter((b) => b.getAttribute("aria-pressed") === "true")
      .reduce((sum, b) => sum + Number(b.dataset.amps ?? 0), 0);
    const pct = Math.round((load / max) * 100);
    const color = pct >= 90 ? LOAD_OVER : pct >= 70 ? LOAD_HIGH : LOAD_OK;
    const label = pct >= 90 ? "Sobrecarga" : pct >= 70 ? "Carga alta" : "Carga estable";

    if (loadEl) loadEl.textContent = String(load);
    if (pctEl) pctEl.textContent = String(pct);
    if (barEl) {
      barEl.style.width = `${pct}%`;
      barEl.style.backgroundColor = color;
      barEl.style.boxShadow = `0 0 16px ${color}`;
    }
    if (statusDot) statusDot.style.backgroundColor = color;
    if (statusLabel) {
      statusLabel.textContent = label;
      statusLabel.style.color = color;
    }
  };

  breakers.forEach((b) => {
    b.addEventListener("click", () => {
      const on = b.getAttribute("aria-pressed") === "true";
      b.setAttribute("aria-pressed", String(!on));
      const name = b.querySelector(".breaker__name")?.textContent ?? "";
      b.setAttribute("aria-label", `${name} ${!on ? "encendido" : "apagado"}`);
      recalc();
    });
  });

  recalc();
</script>
