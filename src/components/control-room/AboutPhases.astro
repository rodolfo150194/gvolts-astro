---
import { useTranslations } from "@/i18n";

interface Phase {
  n: string;
  title: string;
  text: string;
}

interface Props {
  phases: Phase[];
}

const { phases } = Astro.props;
const t = useTranslations(Astro).about;
---

<section class="phases py-[clamp(80px,10vw,150px)] border-t border-[var(--cr-line)]" id="proceso" data-phases>
  <div class="cr-wrap">
    <header class="phases__head">
      <p class="cr-label" data-reveal>{t.phasesLabel}</p>
      <h2 class="mt-[18px] text-[length:clamp(48px,7vw,100px)]" data-reveal style="--d:80ms">{t.phasesTitle1}<br />{t.phasesTitle2}</h2>
    </header>

    <ol class="phases__grid list-none m-0 mt-[clamp(48px,6vw,80px)] p-0 grid grid-cols-1 min-[860px]:grid-cols-3 gap-[1px] bg-[var(--cr-line)] border border-[var(--cr-line)]">
      {
        phases.map((p, i) => (
          <li class="phase relative p-[36px_32px_40px] bg-[var(--cr-ink-2)] flex flex-col gap-[14px] transition-colors duration-300 hover:bg-[var(--cr-ink-3)]" data-reveal style={`--d:${i * 110}ms`}>
            <span class="phase__n [font-family:var(--cr-display)] font-black text-[length:clamp(56px,6vw,88px)] leading-[0.8] text-transparent [-webkit-text-stroke:1.5px_var(--cr-signal)]">{p.n}</span>
            <h3 class="text-[length:clamp(26px,2.4vw,34px)]">{p.title}</h3>
            <p class="text-[17px] leading-[1.6] text-[var(--cr-bone-dim)]">{p.text}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>
