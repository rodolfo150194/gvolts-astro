---
import type { ImageMetadata } from "astro";
import { ChevronDown, Phone } from "@lucide/astro";
import Logo from "@/components/ui/Logo.astro";
import SocialLinks from "@/components/ui/SocialLinks.astro";
import { CONTACT } from "@/data/company";
import { NAV_COMPANY, NAV_SERVICES, navLinks } from "@/data/site";
import { LOCALES, LOCALE_META, fmt, i18n, switchLocalePath } from "@/i18n";

interface Props {
  logo?: ImageMetadata;
}

const { logo } = Astro.props;
const { locale, tr, href } = i18n(Astro);
const services = navLinks(NAV_SERVICES, locale);
const links = navLinks(NAV_COMPANY, locale);
const path = Astro.url.pathname.replace(/(.)\/$/, "$1");
const current = (href: string) => (path === href ? "page" : undefined);

// Selector de idioma: la misma página en cada idioma
const languages = LOCALES.map((l) => ({
  locale: l,
  label: LOCALE_META[l].label,
  name: LOCALE_META[l].name,
  lang: LOCALE_META[l].htmlLang,
  href: switchLocalePath(path, l),
  active: l === locale,
}));

---

<header data-site-nav class="fixed inset-x-0 top-0 z-50 [background:color-mix(in_srgb,var(--cr-ink)_82%,transparent)] backdrop-blur-[14px] backdrop-saturate-[120%] border-b border-[var(--cr-line)]">
  <div class="border-b border-[var(--cr-line)] [font-family:var(--cr-mono)] text-[13px] tracking-[0.12em] uppercase text-[var(--cr-bone-dim)]">
    <div class="cr-wrap flex items-center gap-[28px] h-[32px] max-[640px]:gap-[16px] max-[400px]:h-auto max-[400px]:flex-wrap max-[400px]:gap-x-[16px] max-[400px]:gap-y-[6px] max-[400px]:py-[6px]">
      <a href={`mailto:${CONTACT.email}`} class="inline-flex items-center gap-[10px] whitespace-nowrap text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)] max-[640px]:text-[12px]">{CONTACT.email}</a>
      <a class="inline-flex items-center gap-[10px] whitespace-nowrap text-[var(--cr-bone)] hover:text-[var(--cr-signal)]" href={CONTACT.phoneHref}>{CONTACT.phone}</a>
      
      <SocialLinks class="flex items-center gap-[12px] ml-auto max-[400px]:ml-0" linkClass="[&_svg]:w-[14px] [&_svg]:h-[14px]" />
    </div>
  </div>

  <nav class="cr-wrap flex items-center justify-between gap-[24px] h-[72px] max-[640px]:gap-[16px] max-[400px]:h-[60px]" aria-label={tr.nav.primary}>
    <Logo image={logo} imageClass="h-[44px] w-auto max-[400px]:h-[36px]" class="text-[30px] max-[640px]:text-[24px] max-[400px]:text-[19px]" hideCorpOnTiny />

    <ul class="flex gap-[36px] max-[1100px]:gap-[22px] list-none m-0 p-0 [font-family:var(--cr-mono)] text-[14px] tracking-[0.1em] uppercase max-[860px]:hidden">
      <li class="relative group flex items-center">
        <button
          type="button"
          aria-haspopup="true"
          class="flex items-center gap-[6px] relative py-[6px] m-0 bg-transparent border-0 appearance-none cursor-pointer [font-family:var(--cr-mono)] text-[14px] leading-none tracking-[0.1em] uppercase text-[var(--cr-bone)] after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-[var(--cr-signal)] after:origin-right after:scale-x-0 after:transition-transform after:duration-[350ms] after:ease-[cubic-bezier(0.2,0.7,0.1,1)] group-hover:after:origin-left group-hover:after:scale-x-100"
        >
          {tr.nav.services}
          <ChevronDown size={14} class="transition-transform duration-300 group-hover:rotate-180" />
        </button>
        <ul
          class="absolute top-full left-0 mt-[12px] w-[260px] list-none m-0 p-[8px] [background:var(--cr-ink-2)] border border-[var(--cr-line)] opacity-0 invisible translate-y-[8px] transition-all duration-300 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 group-focus-within:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 normal-case tracking-normal"
        >
          {services.map((s) => (
            <li>
              <a href={s.href} aria-current={current(s.href)} class="block px-[14px] py-[12px] text-[14px] [font-family:var(--cr-body)] text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)] hover:bg-[var(--cr-ink-3)] transition-colors">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </li>
      {links.map((l) => <li class="flex items-center"><a href={l.href} aria-current={current(l.href)} class="inline-flex items-center relative aria-[current=page]:text-[var(--cr-signal)] py-[6px] leading-none after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-[var(--cr-signal)] after:origin-right after:scale-x-0 after:transition-transform after:duration-[350ms] after:ease-[cubic-bezier(0.2,0.7,0.1,1)] hover:after:origin-left hover:after:scale-x-100">{l.label}</a></li>)}
    </ul>

    <div class="flex items-center gap-[12px] max-[860px]:hidden">
      <ul class="lang-switch flex items-stretch h-[44px] list-none m-0 p-0 border border-[var(--cr-line-strong)] [font-family:var(--cr-mono)] text-[12px] font-semibold tracking-[0.14em] uppercase" aria-label={tr.lang.label}>
        {languages.map((l) => (
          <li class="flex">
            {l.active ? (
              <span class="lang-switch__item is-active" aria-current="true" title={l.name}>{l.label}</span>
            ) : (
              <a href={l.href} hreflang={l.lang} lang={l.lang} class="lang-switch__item" title={l.name} aria-label={fmt(tr.lang.switchTo, { language: l.name })} data-lang-switch>{l.label}</a>
            )}
          </li>
        ))}
      </ul>
      <a href={CONTACT.phoneHref} class="cr-btn cr-btn--ghost !min-h-[44px] !px-[16px] gap-[8px] whitespace-nowrap max-[1239px]:!hidden"><Phone size={15} aria-hidden="true" />{CONTACT.phone}</a>
      <a href={href("/contact")} class="cr-btn !min-h-[44px] !px-[20px] whitespace-nowrap">{tr.nav.quote}</a>
    </div>

    <a href={CONTACT.phoneHref} class="hidden ml-auto items-center justify-center w-[44px] h-[44px] border border-[var(--cr-line-strong)] text-[var(--cr-signal)] max-[860px]:flex" aria-label={fmt(tr.nav.callAria, { phone: CONTACT.phone })}>
      <Phone size={18} />
    </a>

    <button
      type="button"
      class="hidden flex-col justify-center gap-[5px] w-[44px] h-[44px] p-0 bg-transparent border border-[var(--cr-line-strong)] cursor-pointer max-[860px]:flex"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label={tr.nav.openMenu}
      data-label-open={tr.nav.openMenu}
      data-label-close={tr.nav.closeMenu}
    >
      <span class="block w-[20px] h-[2px] mx-auto bg-[var(--cr-bone)]"></span>
      <span class="block w-[20px] h-[2px] mx-auto bg-[var(--cr-bone)]"></span>
      <span class="block w-[20px] h-[2px] mx-auto bg-[var(--cr-bone)]"></span>
    </button>
  </nav>

  <ul id="nav-mobile" class="flex-col list-none m-0 pt-[12px] pb-[20px] px-[var(--cr-gutter,24px)] [font-family:var(--cr-mono)] text-[15px] tracking-[0.08em] uppercase border-t border-[var(--cr-line)] [&:not([hidden])]:flex" data-nav-mobile hidden>
    <li class="border-b border-[var(--cr-line)]">
      <details class="group">
        <summary class="flex items-center justify-between py-[14px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          {tr.nav.services}
          <ChevronDown size={16} class="transition-transform duration-300 group-open:rotate-180" />
        </summary>
        <ul class="list-none m-0 pb-[10px] pl-[16px] normal-case tracking-normal">
          {services.map((s) => (
            <li><a href={s.href} aria-current={current(s.href)} class="block py-[10px] text-[14px] text-[var(--cr-bone-dim)]">{s.label}</a></li>
          ))}
        </ul>
      </details>
    </li>
    {links.map((l) => <li class="border-b border-[var(--cr-line)]"><a href={l.href} aria-current={current(l.href)} class="block py-[14px] aria-[current=page]:text-[var(--cr-signal)]">{l.label}</a></li>)}
    <li class="border-b border-[var(--cr-line)]"><a href={href("/contact")} class="cr-btn !block !px-0 !py-[14px] !min-h-[44px] my-[12px]">{tr.nav.quote}</a></li>

    <li class="flex items-center justify-between gap-[16px] py-[14px] border-b border-[var(--cr-line)]">
      <span class="cr-label">{tr.lang.label}</span>
      <ul class="lang-switch flex items-stretch h-[44px] list-none m-0 p-0 border border-[var(--cr-line-strong)] text-[13px] font-semibold tracking-[0.14em]" aria-label={tr.lang.label}>
        {languages.map((l) => (
          <li class="flex">
            {l.active ? (
              <span class="lang-switch__item is-active" aria-current="true">{l.label}<span class="sr-only"> · {l.name}</span></span>
            ) : (
              <a href={l.href} hreflang={l.lang} lang={l.lang} class="lang-switch__item" aria-label={fmt(tr.lang.switchTo, { language: l.name })} data-lang-switch>{l.label}</a>
            )}
          </li>
        ))}
      </ul>
    </li>

    <li class="pt-[16px] normal-case tracking-normal">
      <p class="cr-label mb-[10px]">{tr.nav.contact}</p>
      <a href={CONTACT.phoneHref} class="block py-[4px] text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)]">{CONTACT.phone}</a>
      <a href={`mailto:${CONTACT.email}`} class="block py-[4px] text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)]">{CONTACT.email}</a>
      <p class="py-[4px] text-[var(--cr-bone-dim)]">{CONTACT.address.join(", ")}</p>
      <SocialLinks class="flex gap-[16px] mt-[14px]" />
    </li>
  </ul>
</header>
<div data-site-nav-spacer class="h-[105px] max-[400px]:h-[112px]" aria-hidden="true"></div>

<!-- Barra fija en móvil: las dos acciones que busca quien llega desde el teléfono -->
<div class="cr-actionbar fixed inset-x-0 bottom-0 z-[80] hidden grid-cols-2 border-t border-[var(--cr-line-strong)] [background:var(--cr-ink)] max-[860px]:grid pb-[env(safe-area-inset-bottom)]">
  <a href={CONTACT.phoneHref} class="flex items-center justify-center gap-[10px] h-[56px] [font-family:var(--cr-mono)] text-[14px] font-semibold tracking-[0.1em] uppercase text-[var(--cr-bone)] border-r border-[var(--cr-line-strong)]">
    <Phone size={16} aria-hidden="true" />{tr.nav.call}
  </a>
  <a href={href("/contact")} class="flex items-center justify-center gap-[10px] h-[56px] [font-family:var(--cr-mono)] text-[14px] font-semibold tracking-[0.1em] uppercase bg-[var(--cr-signal)] text-[var(--cr-ink)]">
    {tr.nav.quote} <span aria-hidden="true">→</span>
  </a>
</div>

<style>
  .lang-switch__item {
    display: grid; place-items: center; min-width: 44px; padding: 0 12px;
    color: var(--cr-bone-dim); transition: background-color 0.2s, color 0.2s;
  }
  .lang-switch li + li .lang-switch__item { border-left: 1px solid var(--cr-line-strong); }
  a.lang-switch__item:hover, a.lang-switch__item:focus-visible { color: var(--cr-bone); background: var(--cr-ink-3); }
  .lang-switch__item.is-active { background: var(--cr-signal); color: var(--cr-ink); }
</style>

<script>
  // Al cambiar de idioma se conserva el ancla (#seccion) de la página actual
  document.querySelectorAll<HTMLAnchorElement>("[data-lang-switch]").forEach((link) => {
    link.addEventListener("click", () => {
      if (window.location.hash) link.hash = window.location.hash;
    });
  });

  const siteNav = document.querySelector<HTMLElement>("[data-site-nav]");
  const navSpacer = document.querySelector<HTMLElement>("[data-site-nav-spacer]");
  const syncNavSpacer = () => {
    if (!siteNav || !navSpacer) return;
    navSpacer.style.height = `${siteNav.offsetHeight}px`;
  };
  syncNavSpacer();
  window.addEventListener("resize", syncNavSpacer, { passive: true });
  if (siteNav && navSpacer && "ResizeObserver" in window) {
    new ResizeObserver(syncNavSpacer).observe(siteNav);
  }

  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const mobile = document.querySelector<HTMLElement>("[data-nav-mobile]");
  if (toggle && mobile) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", (isOpen ? toggle.dataset.labelOpen : toggle.dataset.labelClose) ?? "");
      mobile.hidden = isOpen;
      syncNavSpacer();
    });

    mobile.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", toggle.dataset.labelOpen ?? "");
        mobile.hidden = true;
        syncNavSpacer();
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", toggle.dataset.labelOpen ?? "");
        mobile.hidden = true;
        syncNavSpacer();
        toggle.focus();
      }
    });
  }
</script>
