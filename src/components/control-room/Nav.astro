---
import type { ImageMetadata } from "astro";
import { ChevronDown, Phone } from "@lucide/astro";
import { socials } from "@/data/socials";
import { CONTACT } from "@/data/company";

interface Props {
  logo?: ImageMetadata;
}

const { logo } = Astro.props;

const services = [
  { label: "Alarmas de Incendio", href: "/services/fire-alarm" },
  { label: "Seguridad Electrónica", href: "/services/security" },
  { label: "Electricidad", href: "/services/electricity" },
];

const links = [
  { label: "Proyectos", href: "/projects" },
  { label: "Nosotros", href: "/about" },
  { label: "Contacto", href: "/contact" },
];
---

<header class="sticky top-0 z-50 [background:color-mix(in_srgb,var(--cr-ink)_82%,transparent)] backdrop-blur-[14px] backdrop-saturate-[120%] border-b border-[var(--cr-line)]">
  <div class="border-b border-[var(--cr-line)] [font-family:var(--cr-mono)] text-[11px] tracking-[0.12em] uppercase text-[var(--cr-bone-dim)]">
    <div class="cr-wrap flex items-center gap-[28px] h-[32px] max-[640px]:gap-[16px] max-[400px]:h-auto max-[400px]:flex-wrap max-[400px]:gap-x-[16px] max-[400px]:gap-y-[6px] max-[400px]:py-[6px]">
      <a href={`mailto:${CONTACT.email}`} class="inline-flex items-center gap-[10px] whitespace-nowrap text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)] max-[640px]:text-[10px]">{CONTACT.email}</a>
      <a class="inline-flex items-center gap-[10px] whitespace-nowrap text-[var(--cr-bone)] hover:text-[var(--cr-signal)]" href={CONTACT.phoneHref}>{CONTACT.phone}</a>
      
      <div class="inline-flex items-center gap-[18px] ml-auto max-[400px]:ml-0 max-[400px]:basis-full max-[400px]:justify-between">
        <div class="flex items-center gap-[12px]">
          {socials.map((social) => (
            <a
              href={social.url}
              aria-label={social.ariaLabel}
              class="text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)] transition-colors [&_svg]:w-[14px] [&_svg]:h-[14px]"
              target="_blank"
              rel="noopener noreferrer"
              set:html={social.icon}
            />
          ))}
        </div>
        </div>
    </div>
  </div>

  <nav class="cr-wrap flex items-center justify-between gap-[24px] h-[72px] max-[640px]:gap-[16px] max-[400px]:h-[60px]" aria-label="Principal">
    <a href="/" class="inline-flex items-center" aria-label="GVolts Corp, inicio">
      {logo ? (
        <img src={logo.src} alt="GVolts Corp" width={logo.width} height={logo.height} class="h-[44px] w-auto max-[400px]:h-[36px]" />
      ) : (
        <span class="inline-flex items-stretch [font-family:var(--cr-display)] font-black text-[30px] leading-none tracking-[0.02em] max-[640px]:text-[24px] max-[400px]:text-[19px]">
          <span class="bg-[var(--cr-bone)] text-[var(--cr-ink)] pt-[6px] pr-[6px] pb-[4px] pl-[8px]">G</span><span class="bg-[var(--cr-signal-deep)] text-[var(--cr-ink)] pt-[6px] pr-[8px] pb-[4px] pl-[4px]">VOLTS</span>
          <span class="[writing-mode:vertical-rl] [font-family:var(--cr-mono)] text-[8px] font-bold tracking-[0.2em] bg-[var(--cr-ink-3)] text-[var(--cr-bone)] px-[4px] py-[3px] grid place-items-center max-[400px]:hidden">CORP</span>
        </span>
      )}
    </a>

    <ul class="flex gap-[36px] list-none m-0 p-0 [font-family:var(--cr-mono)] text-[13px] tracking-[0.1em] uppercase max-[860px]:hidden">
      <li class="relative group flex items-center">
        <button
          type="button"
          class="flex items-center gap-[6px] relative py-[6px] m-0 bg-transparent border-0 appearance-none cursor-pointer [font-family:var(--cr-mono)] text-[13px] leading-none tracking-[0.1em] uppercase text-[var(--cr-bone)] after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-[var(--cr-signal)] after:origin-right after:scale-x-0 after:transition-transform after:duration-[350ms] after:ease-[cubic-bezier(0.2,0.7,0.1,1)] group-hover:after:origin-left group-hover:after:scale-x-100"
        >
          Servicios
          <ChevronDown size={14} class="transition-transform duration-300 group-hover:rotate-180" />
        </button>
        <ul
          class="absolute top-full left-0 mt-[12px] w-[260px] list-none m-0 p-[8px] [background:var(--cr-ink-2)] border border-[var(--cr-line)] opacity-0 invisible translate-y-[8px] transition-all duration-300 group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 normal-case tracking-normal"
        >
          {services.map((s) => (
            <li>
              <a href={s.href} class="block px-[14px] py-[12px] text-[13px] [font-family:var(--cr-body)] text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)] hover:bg-[var(--cr-ink-3)] transition-colors">
                {s.label}
              </a>
            </li>
          ))}
        </ul>
      </li>
      {links.map((l) => <li class="flex items-center"><a href={l.href} class="inline-flex items-center relative py-[6px] leading-none after:content-[''] after:absolute after:left-0 after:bottom-0 after:h-px after:w-full after:bg-[var(--cr-signal)] after:origin-right after:scale-x-0 after:transition-transform after:duration-[350ms] after:ease-[cubic-bezier(0.2,0.7,0.1,1)] hover:after:origin-left hover:after:scale-x-100">{l.label}</a></li>)}
    </ul>

    <div class="flex items-center gap-[12px] max-[860px]:hidden">
      <a href={CONTACT.phoneHref} class="cr-btn cr-btn--ghost !min-h-[44px] !px-[16px] gap-[8px]"><Phone size={15} aria-hidden="true" />{CONTACT.phone}</a>
      <a href="/contact" class="cr-btn !min-h-[44px] !px-[20px]">Cotizar gratis</a>
    </div>

    <a href={CONTACT.phoneHref} class="hidden ml-auto items-center justify-center w-[44px] h-[44px] border border-[var(--cr-line-strong)] text-[var(--cr-signal)] max-[860px]:flex" aria-label={`Llamar al ${CONTACT.phone}`}>
      <Phone size={18} />
    </a>

    <button
      type="button"
      class="hidden flex-col justify-center gap-[5px] w-[44px] h-[44px] p-0 bg-transparent border border-[var(--cr-line-strong)] cursor-pointer max-[860px]:flex"
      data-nav-toggle
      aria-expanded="false"
      aria-controls="nav-mobile"
      aria-label="Abrir menú"
    >
      <span class="block w-[20px] h-[2px] mx-auto bg-[var(--cr-bone)]"></span>
      <span class="block w-[20px] h-[2px] mx-auto bg-[var(--cr-bone)]"></span>
      <span class="block w-[20px] h-[2px] mx-auto bg-[var(--cr-bone)]"></span>
    </button>
  </nav>

  <ul id="nav-mobile" class="flex-col list-none m-0 pt-[12px] pb-[20px] px-[var(--cr-gutter,24px)] [font-family:var(--cr-mono)] text-[14px] tracking-[0.08em] uppercase border-t border-[var(--cr-line)] [&:not([hidden])]:flex" data-nav-mobile hidden>
    <li class="border-b border-[var(--cr-line)]">
      <details class="group">
        <summary class="flex items-center justify-between py-[14px] cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          Servicios
          <ChevronDown size={16} class="transition-transform duration-300 group-open:rotate-180" />
        </summary>
        <ul class="list-none m-0 pb-[10px] pl-[16px] normal-case tracking-normal">
          {services.map((s) => (
            <li><a href={s.href} class="block py-[10px] text-[13px] text-[var(--cr-bone-dim)]">{s.label}</a></li>
          ))}
        </ul>
      </details>
    </li>
    {links.map((l) => <li class="border-b border-[var(--cr-line)]"><a href={l.href} class="block py-[14px]">{l.label}</a></li>)}
    <li class="border-b border-[var(--cr-line)]"><a href="/contact" class="cr-btn !block !px-0 !py-[14px] !min-h-[44px] my-[12px]">Cotizar gratis</a></li>

    <li class="pt-[16px] normal-case tracking-normal">
      <p class="cr-label mb-[10px]">Contacto</p>
      <a href={CONTACT.phoneHref} class="block py-[4px] text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)]">{CONTACT.phone}</a>
      <a href={`mailto:${CONTACT.email}`} class="block py-[4px] text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)]">{CONTACT.email}</a>
      <p class="py-[4px] text-[var(--cr-bone-dim)]">{CONTACT.address.join(", ")}</p>
      <div class="flex gap-[16px] mt-[14px]">
        {socials.map((social) => (
          <a
            href={social.url}
            aria-label={social.ariaLabel}
            class="text-[var(--cr-bone-dim)] hover:text-[var(--cr-signal)] transition-colors"
            target="_blank"
            rel="noopener noreferrer"
            set:html={social.icon}
          />
        ))}
      </div>
    </li>
  </ul>
</header>

<!-- Barra fija en móvil: las dos acciones que busca quien llega desde el teléfono -->
<div class="cr-actionbar fixed inset-x-0 bottom-0 z-[80] hidden grid-cols-2 border-t border-[var(--cr-line-strong)] [background:var(--cr-ink)] max-[860px]:grid pb-[env(safe-area-inset-bottom)]">
  <a href={CONTACT.phoneHref} class="flex items-center justify-center gap-[10px] h-[56px] [font-family:var(--cr-mono)] text-[13px] font-semibold tracking-[0.1em] uppercase text-[var(--cr-bone)] border-r border-[var(--cr-line-strong)]">
    <Phone size={16} aria-hidden="true" />Llamar
  </a>
  <a href="/contact" class="flex items-center justify-center gap-[10px] h-[56px] [font-family:var(--cr-mono)] text-[13px] font-semibold tracking-[0.1em] uppercase bg-[var(--cr-signal)] text-[var(--cr-ink)]">
    Cotizar gratis <span aria-hidden="true">→</span>
  </a>
</div>

<script>
  const toggle = document.querySelector<HTMLButtonElement>("[data-nav-toggle]");
  const mobile = document.querySelector<HTMLElement>("[data-nav-mobile]");
  if (toggle && mobile) {
    toggle.addEventListener("click", () => {
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!isOpen));
      toggle.setAttribute("aria-label", isOpen ? "Abrir menú" : "Cerrar menú");
      mobile.hidden = isOpen;
    });

    mobile.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Abrir menú");
        mobile.hidden = true;
      });
    });

    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        toggle.setAttribute("aria-expanded", "false");
        toggle.setAttribute("aria-label", "Abrir menú");
        mobile.hidden = true;
        toggle.focus();
      }
    });
  }
</script>
