---
interface Credential {
  value: string;
  label: string;
}

interface Props {
  items: Credential[];
}

const { items } = Astro.props;
---

<section class="credentials py-[clamp(80px,10vw,150px)] border-t border-[var(--cr-line)] bg-[var(--cr-ink-2)]" id="credenciales" data-reveal-group>
  <div class="cr-wrap">
    <header class="credentials__head">
      <p class="cr-label" data-reveal>03 — Respaldo</p>
      <h2 class="mt-[18px] text-[length:clamp(48px,7vw,100px)]" data-reveal style="--d:80ms">Credenciales<br />que nos avalan.</h2>
    </header>

    <ul class="credentials__grid list-none m-0 mt-[clamp(48px,6vw,80px)] p-0 grid grid-cols-1 min-[560px]:grid-cols-2 min-[860px]:grid-cols-3 gap-[1px] bg-[var(--cr-line)] border border-[var(--cr-line)]">
      {
        items.map((c, i) => (
          <li class="credential p-[30px_24px] bg-[var(--cr-ink-3)] flex flex-col gap-[10px] transition-colors duration-300" data-reveal style={`--d:${i * 70}ms`}>
            <p class="credential__value font-[var(--cr-display)] font-extrabold text-[length:clamp(30px,3vw,42px)] leading-none text-[var(--cr-signal)]">{c.value}</p>
            <p class="credential__label cr-label max-w-[24ch]">{c.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
