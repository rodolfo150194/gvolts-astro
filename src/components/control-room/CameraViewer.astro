---
interface Mode {
  id: "day" | "night" | "ai";
  label: string;
  tag: string;
  note: string;
}

const modes: Mode[] = [
  {
    id: "day",
    label: "Día",
    tag: "MODO DÍA · WDR 120dB",
    note: "Imagen 4K con WDR para contraluces fuertes: detalle en sombras y en luces al mismo tiempo.",
  },
  {
    id: "night",
    label: "Nocturno IR",
    tag: "IR ACTIVO · 30 m",
    note: "Iluminación infrarroja invisible: imagen nítida hasta 30 metros en oscuridad total.",
  },
  {
    id: "ai",
    label: "Analítica IA",
    tag: "IA · 3 ZONAS ACTIVAS",
    note: "Zonas y líneas virtuales: la IA solo te alerta cuando algo cruza el perímetro.",
  },
];
---

<div class="flex flex-col gap-4" data-camera-viewer>
  <div class="group relative aspect-[620/480] overflow-hidden bg-black border border-[var(--cr-line-strong)] is-ai" data-cv-frame>
    <img
      src="/img/gvolts/camara-casa.jpg"
      alt="Vista de cámara de seguridad sobre la fachada de una casa al anochecer"
      class="absolute inset-0 w-full h-full object-cover saturate-[.9] contrast-[1.05] transition-[filter] duration-500 group-[.is-night]:grayscale-100 group-[.is-night]:sepia group-[.is-night]:hue-rotate-[70deg] group-[.is-night]:saturate-[2.4] group-[.is-night]:brightness-110 group-[.is-night]:contrast-[1.25] group-[.is-ai]:grayscale-[.85] group-[.is-ai]:brightness-[.72] group-[.is-ai]:contrast-[1.15]"
      data-cv-img
      loading="eager"
    />

    <div
      class="absolute -inset-[5%] w-[110%] h-[110%] pointer-events-none opacity-0 bg-[repeating-linear-gradient(0deg,rgba(0,0,0,0.18)_0px,rgba(0,0,0,0.18)_1px,transparent_1px,transparent_3px)] group-[.is-night]:opacity-100 group-[.is-night]:animate-[cv-noise_0.35s_steps(2,end)_infinite] motion-reduce:animate-none!"
      data-cv-noise
      aria-hidden="true"
    ></div>

    <div class="absolute inset-0 opacity-0 transition-opacity duration-300 group-[.is-ai]:opacity-100" data-cv-ai aria-hidden="true">
      <div class="absolute box-border border-2 border-solid animate-[cv-lock_1.8s_ease-out_infinite] motion-reduce:animate-none!" style="left:13.9%;top:67.1%;width:20%;height:21.7%;border-color:var(--cr-signal)">
        <span class="absolute -left-[2px] -top-[24px] py-[3px] px-2 text-[var(--cr-ink)] [font-family:var(--cr-mono)] text-[10px] font-bold whitespace-nowrap" style="background:var(--cr-signal)">ZONA 01 · GARAJE</span>
      </div>
      <div class="absolute box-border border-2 border-solid animate-[cv-lock_1.8s_ease-out_infinite] motion-reduce:animate-none!" style="left:42.9%;top:62.5%;width:9.4%;height:28.75%;border-color:var(--cr-amber)">
        <span class="absolute -left-[2px] -top-[24px] py-[3px] px-2 text-[var(--cr-ink)] [font-family:var(--cr-mono)] text-[10px] font-bold whitespace-nowrap" style="background:var(--cr-amber)">ACCESO PRINCIPAL</span>
      </div>
      <div class="absolute box-border border border-dashed border-[rgba(237,232,224,0.7)]" style="left:23.5%;top:20.8%;width:33.9%;height:28.75%">
        <span class="absolute left-[6px] bottom-[6px] [font-family:var(--cr-mono)] text-[9px] tracking-[0.08em] text-[var(--cr-bone)]">VENTANAS · SIN MOVIMIENTO</span>
      </div>
      <div class="absolute left-0 top-[94.2%] w-[74.2%] border-t-2 border-dashed border-[#e0605a]"></div>
      <span class="absolute left-[1.9%] top-[89.6%] [font-family:var(--cr-mono)] text-[9px] tracking-[0.1em] text-[#e0605a]">LÍNEA VIRTUAL · PERÍMETRO</span>
    </div>

    <div
      class="absolute left-0 right-0 -top-[4%] h-[2px] bg-[color-mix(in_srgb,var(--cr-signal)_60%,transparent)] shadow-[0_0_18px_2px_color-mix(in_srgb,var(--cr-signal)_40%,transparent)] animate-[cv-scan_4s_linear_infinite] motion-reduce:animate-none!"
      aria-hidden="true"
    ></div>

    <span class="absolute w-5 h-5 border-solid border-0 border-[var(--cr-bone)] left-3 top-3 border-t-2 border-l-2 max-[480px]:w-3.5 max-[480px]:h-3.5 max-[480px]:left-2 max-[480px]:top-2" aria-hidden="true"></span>
    <span class="absolute w-5 h-5 border-solid border-0 border-[var(--cr-bone)] right-3 top-3 border-t-2 border-r-2 max-[480px]:w-3.5 max-[480px]:h-3.5 max-[480px]:right-2 max-[480px]:top-2" aria-hidden="true"></span>
    <span class="absolute w-5 h-5 border-solid border-0 border-[var(--cr-bone)] left-3 bottom-3 border-b-2 border-l-2 max-[480px]:w-3.5 max-[480px]:h-3.5 max-[480px]:left-2 max-[480px]:bottom-2" aria-hidden="true"></span>
    <span class="absolute w-5 h-5 border-solid border-0 border-[var(--cr-bone)] right-3 bottom-3 border-b-2 border-r-2 max-[480px]:w-3.5 max-[480px]:h-3.5 max-[480px]:right-2 max-[480px]:bottom-2" aria-hidden="true"></span>

    <div class="absolute left-11 right-11 top-[18px] flex justify-between [font-family:var(--cr-mono)] text-[10px] tracking-[0.12em] text-[var(--cr-bone)] max-[480px]:left-[30px] max-[480px]:right-[30px] max-[480px]:top-3 max-[480px]:text-[9px]">
      <span class="inline-flex items-center gap-2"><span class="w-[7px] h-[7px] rounded-full bg-[#e0605a] animate-[cv-blink_1.1s_steps(1,end)_infinite] motion-reduce:animate-none!"></span>REC · CAM-02 · 4K</span>
      <span data-cv-tag>{modes[2].tag}</span>
    </div>
  </div>

  <div class="grid grid-cols-3 gap-2 max-[480px]:grid-cols-2 max-[480px]:gap-1.5" role="group" aria-label="Modo de cámara">
    {
      modes.map((m) => (
        <button
          type="button"
          class={`appearance-none h-12 border border-[var(--cr-line-strong)] bg-transparent text-[var(--cr-bone)] [font-family:var(--cr-mono)] text-[11px] tracking-[0.1em] uppercase cursor-pointer transition-[background-color,color,border-color] duration-200 hover:border-[var(--cr-signal)] aria-pressed:bg-[var(--cr-signal)] aria-pressed:border-[var(--cr-signal)] aria-pressed:text-[var(--cr-ink)] max-[480px]:h-auto max-[480px]:min-h-[44px] max-[480px]:py-2 max-[480px]:px-1.5 max-[480px]:text-[10px] max-[480px]:tracking-[0.06em] ${m.id === "ai" ? "max-[480px]:col-span-2" : ""}`}
          data-cv-mode={m.id}
          data-tag={m.tag}
          data-note={m.note}
          aria-pressed={m.id === "ai" ? "true" : "false"}
        >
          {m.label}
        </button>
      ))
    }
  </div>

  <p class="m-0 text-sm leading-[1.55] text-[var(--cr-bone-dim)]" data-cv-note>{modes[2].note}</p>
</div>

<style>
  @keyframes cv-noise {
    0% { transform: translate(0, 0); }
    25% { transform: translate(-2%, 1%); }
    50% { transform: translate(1%, -2%); }
    75% { transform: translate(-1%, 2%); }
    100% { transform: translate(0, 0); }
  }

  @keyframes cv-lock {
    0%, 100% { box-shadow: 0 0 0 0 rgba(255, 255, 255, 0); }
    50% { box-shadow: 0 0 0 6px rgba(255, 255, 255, 0); }
  }

  @keyframes cv-scan {
    from { top: -4%; }
    to { top: 104%; }
  }

  @keyframes cv-blink {
    0%, 55% { opacity: 1; }
    56%, 100% { opacity: 0.2; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-camera-viewer]");
  if (!root) throw new Error("CameraViewer root not found");

  const frame = root.querySelector<HTMLElement>("[data-cv-frame]");
  const tag = root.querySelector<HTMLElement>("[data-cv-tag]");
  const note = root.querySelector<HTMLElement>("[data-cv-note]");
  const buttons = [...root.querySelectorAll<HTMLButtonElement>("[data-cv-mode]")];

  const setMode = (mode: string) => {
    frame?.classList.toggle("is-night", mode === "night");
    frame?.classList.toggle("is-ai", mode === "ai");

    buttons.forEach((btn) => {
      const on = btn.dataset.cvMode === mode;
      btn.setAttribute("aria-pressed", String(on));
      if (on) {
        if (tag) tag.textContent = btn.dataset.tag ?? "";
        if (note) note.textContent = btn.dataset.note ?? "";
      }
    });
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => setMode(btn.dataset.cvMode!));
  });
</script>
